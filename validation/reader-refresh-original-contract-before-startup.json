{
  "id": "sheafreader_refresh_feeds_sequential",
  "host_app": {
    "name": "Sheaf-Reader (束阅 RSS 阅读器)",
    "repository": "https://github.com/simon2137/Sheaf-Reader",
    "bundle_name": "com.sheafreader.hm",
    "local_path": "hosts/sheafreader",
    "base_branch": "ohmbase",
    "base_commit": "e04ef65"
  },
  "android_source_case": "portauthority_scan_scheduling",
  "android_mechanism": "Worker scheduling not adapted to the workload; fix parallelizes/adapts scheduling",
  "category": "latency",
  "bug_description": "refreshAllFeeds fetches every due feed strictly sequentially (await per feed inside a for loop). Each fetch waits for the previous feed's full network round-trip and parse, so refreshing many subscriptions takes the SUM of all per-feed latencies instead of overlapping them.",
  "perf_scenarios": [
    "网络结果渲染",
    "页面启动"
  ],
  "unfixed_commit": "20963f3238e40c8e2a196dcb275bd1fa10f4cd8e",
  "fixed_commit": "21b43e274476c00939eecd80a07b0a9e7501774b",
  "fix_summary": "Due feeds are fetched by a bounded worker pool (4 concurrent), overlapping network latency while limiting parallelism.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_sheafreader_0040",
    "py_file": "testcase/PerfLoad_sheafreader_0040.py",
    "descriptor": "testcase/PerfLoad_sheafreader_0040.json",
    "install_dir": "perf_testing/hapray/testcases/com.sheafreader.hm",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_sheafreader_0040.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 60,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "trace_cpu_ms",
    "definition": "on-CPU time of the app process during the measured step, from the sched events in trace.htrace.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean_failed",
      "metric": "trace_cpu_ms",
      "unfixed": [
        1365.899,
        1464.501,
        1420.71
      ],
      "fixed": [
        3827.103,
        3883.931,
        3550.841
      ],
      "median_ratio": 0.37122335092627506,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Native scheduling recomputed for every round; unchanged 1.2x paired and median criteria."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Wall time from refresh start to the last feed's completion, from network activity in the trace.",
      "comparison": "unfixed total ~= sum of per-feed latencies (serialized request timeline); fixed overlaps up to 4 fetches. With 10+ feeds, fixed refresh time <= ~50% of unfixed."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "trace_cpu_ms",
      "unfixed": [
        5420,
        5515,
        5039
      ],
      "fixed": [
        3930,
        4112,
        3812
      ],
      "note": "cpu 5420 vs 3930 ms (+38%, disjoint ranges); total instructions match because the same fetches run, so the oracle is sched CPU time"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
