From 20e8e16b0c81fd5dee14b636433089cc2796f707 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:52:04 +0800
Subject: [PATCH 2/3] fix: destroy the HTTP session after each weather request
 to avoid leaking connections and fds

---
 alatus/src/main/ets/viewmodel/getWeatherUtil.ets | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/alatus/src/main/ets/viewmodel/getWeatherUtil.ets b/alatus/src/main/ets/viewmodel/getWeatherUtil.ets
index 4326d7d..7ab0698 100644
--- a/alatus/src/main/ets/viewmodel/getWeatherUtil.ets
+++ b/alatus/src/main/ets/viewmodel/getWeatherUtil.ets
@@ -15,6 +15,9 @@ class getWeatherUtil{
         }
       }).catch((err:object)=>{
         console.log(err.toString());
+      }).finally(()=>{
+        // 请求结束后销毁 HTTP 会话，避免连接与句柄滞留
+        request.destroy();
       });
     });
   }
