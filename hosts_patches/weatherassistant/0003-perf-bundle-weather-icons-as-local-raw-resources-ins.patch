From c181b312ec1c31ad1ea13641b2953fa2efd4778f Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:52:53 +0800
Subject: [PATCH 3/3] perf: bundle weather icons as local raw resources instead
 of fetching static glyphs from a remote CDN on every render

---
 alatus/src/main/ets/view/cityView.ets            |   9 +++++----
 .../main/resources/rawfile/weather/cloudy.img    | Bin 0 -> 1177 bytes
 .../main/resources/rawfile/weather/overcast.img  | Bin 0 -> 1176 bytes
 .../src/main/resources/rawfile/weather/rain.img  | Bin 0 -> 1421 bytes
 .../src/main/resources/rawfile/weather/sunny.img | Bin 0 -> 1858 bytes
 5 files changed, 5 insertions(+), 4 deletions(-)
 create mode 100644 alatus/src/main/resources/rawfile/weather/cloudy.img
 create mode 100644 alatus/src/main/resources/rawfile/weather/overcast.img
 create mode 100644 alatus/src/main/resources/rawfile/weather/rain.img
 create mode 100644 alatus/src/main/resources/rawfile/weather/sunny.img

diff --git a/alatus/src/main/ets/view/cityView.ets b/alatus/src/main/ets/view/cityView.ets
index bfb53d2..50332c9 100644
--- a/alatus/src/main/ets/view/cityView.ets
+++ b/alatus/src/main/ets/view/cityView.ets
@@ -4,21 +4,22 @@ import { cast } from '../viewmodel/cast';
 export struct cityView{
   // 获取数据,城市数据
   casts:Array<cast> = [];
+  // 天气图标使用本地静态资源，避免每次渲染都从远程 CDN 加载
   @Builder weatherImage(weather:string,width:number,height:number){
     if(weather === "晴"){
-      Image("https://i-blog.csdnimg.cn/direct/bf01538113ef4f218fd4495c430e0568.jpeg")
+      Image($rawfile('weather/sunny.img'))
         .width(width).height(height);
     }
     if(weather === "阴"){
-      Image("https://i-blog.csdnimg.cn/direct/cdccb8075bb8473db2672bed70190ba7.jpeg")
+      Image($rawfile('weather/overcast.img'))
         .width(width).height(height);
     }
     if(weather === "多云"){
-      Image("https://i-blog.csdnimg.cn/direct/cc6430c2542b4f49b98d33bac2005829.jpeg")
+      Image($rawfile('weather/cloudy.img'))
         .width(width).height(height);
     }
     if(weather.includes("雨")){
-      Image("https://i-blog.csdnimg.cn/direct/de1260f193c446e7a1e9468140997ae2.jpeg")
+      Image($rawfile('weather/rain.img'))
         .width(width).height(height);
     }
   }
