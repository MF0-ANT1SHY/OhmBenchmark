From ff15a9947c7438848de730bc46b02d5573b7583d Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:04:24 +0800
Subject: [PATCH 6/6] perf: assemble artist names with a single join instead of
 repeated string concatenation in a loop

---
 entry/src/main/ets/common/functions/common/convert.ets | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/entry/src/main/ets/common/functions/common/convert.ets b/entry/src/main/ets/common/functions/common/convert.ets
index 8070680..c4b357e 100644
--- a/entry/src/main/ets/common/functions/common/convert.ets
+++ b/entry/src/main/ets/common/functions/common/convert.ets
@@ -84,11 +84,12 @@ export async function fetchSongInfo(fileName: string): Promise<Song> {
  * @returns
  */
 export function getArtists(artists:Artist[]): string {
-  let artistStr:string = ''
+  // 收集到数组后一次 join，避免循环中反复拼接字符串产生大量中间对象
+  const names: string[] = []
   for(let artist of artists) {
-    artistStr = artistStr + artist.name + ', '
+    names.push(artist.name)
   }
-  return artistStr.slice(0,-2)
+  return names.join(', ')
 }
 
 /**
