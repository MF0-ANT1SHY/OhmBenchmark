From 153f8c7dc8203197ffb3ff14e8856d6c124f001b Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:04:01 +0800
Subject: [PATCH 5/6] perf: render song search results with LazyForEach and a
 data source so off-screen result rows are not created eagerly

---
 entry/src/main/ets/pages/search/SearchSongsList.ets | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/entry/src/main/ets/pages/search/SearchSongsList.ets b/entry/src/main/ets/pages/search/SearchSongsList.ets
index 4c98cb4..9007a36 100644
--- a/entry/src/main/ets/pages/search/SearchSongsList.ets
+++ b/entry/src/main/ets/pages/search/SearchSongsList.ets
@@ -6,6 +6,7 @@ import { Song } from "../../common/entities/song/Song"
 import { ClickToLoadButton, LoadingMoreButton, NoMoreButton } from "../../components/buttons/LoadMoreButtons"
 import { AddToPlayListButton } from "../../components/buttons/play/AddToPlayListButton"
 import { SongCard } from "../../components/cards/SongCard"
+import { LazyData } from "@pie/lazy-data"
 
 /**
  * 搜索结果——单曲列表
@@ -18,6 +19,7 @@ export struct SearchSongsList {
   @StorageProp('topRectHeight') topRectHeight: number = 0
   @Link @Watch('handleSearch') searchKeyword: string
   @State songList: Array<Song> = []
+  @State songDataSource: LazyData<Song> = new LazyData()
   @State songOffset: number = 0
   @State hasMoreSongs: boolean = true
   @State hasSongLoaded: boolean = false
@@ -51,7 +53,7 @@ export struct SearchSongsList {
       .justifyContent(FlexAlign.Center)
     } else {
       List() {
-        ForEach(this.songList, (item: Song) => {
+        LazyForEach(this.songDataSource, (item: Song) => {
           ListItem() {
             SongCard({ song: item })
           }
@@ -61,7 +63,7 @@ export struct SearchSongsList {
             curve: Curve.LinearOutSlowIn
           })
           .translate({ y: 0 })
-        })
+        }, (item: Song, index) => item.id.toString() + index)
         // 添加加载更多
         if (this.isLoadingMore) {
           ListItem() {
@@ -99,6 +101,8 @@ export struct SearchSongsList {
     try {
       const result = await searchSongs(this.searchKeyword, offset)
       this.songList = [...this.songList, ...result.list] // 合并歌曲列表
+      this.songDataSource.setData(this.songList)
+      this.songDataSource.notifyDataReload()
       this.songOffset += 30
       this.hasMoreSongs = result.hasMore
     } catch (e) {
-- 
