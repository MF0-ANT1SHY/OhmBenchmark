From a967ef10ae9722d19100d6dfbf00760467397a3c Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:48:26 +0800
Subject: [PATCH 2/6] perf: pass the LazyForEach index to song cards instead of
 calling list.indexOf(item) twice per row build

---
 entry/src/main/ets/pages/playlist/PlayListPage.ets | 4 ++--
 oh-package-lock.json5                              | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/entry/src/main/ets/pages/playlist/PlayListPage.ets b/entry/src/main/ets/pages/playlist/PlayListPage.ets
index efbae0b..23e10d2 100644
--- a/entry/src/main/ets/pages/playlist/PlayListPage.ets
+++ b/entry/src/main/ets/pages/playlist/PlayListPage.ets
@@ -248,10 +248,10 @@ export struct PlayListPage {
                 alias: [],
                 fee: item.fee
               },
-              sid: this.list.indexOf(item),
+              sid: index,
               playlist: this.param.playList,
               picUrl: item.al?.picUrl ?? $r('app.media.ic_public_music'),
-              index: this.list.indexOf(item),
+              index: index,
               listPlayAction: async () => { await this.playSong(index) }
             })
               .layoutWeight(1)
diff --git a/oh-package-lock.json5 b/oh-package-lock.json5
index cc629ae..3ea9171 100644
--- a/oh-package-lock.json5
+++ b/oh-package-lock.json5
@@ -1,6 +1,7 @@
 {
   "meta": {
-    "stableOrder": true
+    "stableOrder": true,
+    "enableUnifiedLockfile": false
   },
   "lockfileVersion": 3,
   "ATTENTION": "THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.",
-- 
