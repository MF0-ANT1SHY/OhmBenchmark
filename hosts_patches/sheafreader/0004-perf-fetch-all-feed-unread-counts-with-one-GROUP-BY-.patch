From 4c9b8dcdc7f230b68120fb5c7640c4cce3521a88 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:08:20 +0800
Subject: [PATCH 4/5] perf: fetch all feed unread counts with one GROUP BY
 query instead of one COUNT per feed

---
 entry/src/main/ets/data/DatabaseManager.ets | 17 +++++++++++++++++
 entry/src/main/ets/services/FeedService.ets |  5 ++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/entry/src/main/ets/data/DatabaseManager.ets b/entry/src/main/ets/data/DatabaseManager.ets
index de400bc..ac6d8d1 100644
--- a/entry/src/main/ets/data/DatabaseManager.ets
+++ b/entry/src/main/ets/data/DatabaseManager.ets
@@ -588,6 +588,23 @@ export class DatabaseManager {
     return this.getUnreadCount(-1, -1);
   }
 
+  /**
+   * Unread count for every feed in one grouped query, so sidebar refreshes do
+   * not issue one COUNT per feed.
+   */
+  async getUnreadCountsByFeed(): Promise<Map<number, number>> {
+    const counts: Map<number, number> = new Map<number, number>();
+    if (!this.store) return counts;
+    const sql = 'SELECT feed_id, COUNT(*) as cnt FROM articles WHERE read = 0 GROUP BY feed_id';
+    const resultSet = await this.store.querySql(sql);
+    while (resultSet.goToNextRow()) {
+      counts.set(resultSet.getLong(resultSet.getColumnIndex('feed_id')),
+        resultSet.getLong(resultSet.getColumnIndex('cnt')));
+    }
+    resultSet.close();
+    return counts;
+  }
+
   async getStarredCount(): Promise<number> {
     if (!this.store) return 0;
     const sql = 'SELECT COUNT(*) as cnt FROM articles WHERE starred = 1';
diff --git a/entry/src/main/ets/services/FeedService.ets b/entry/src/main/ets/services/FeedService.ets
index 8845e09..45c7eca 100644
--- a/entry/src/main/ets/services/FeedService.ets
+++ b/entry/src/main/ets/services/FeedService.ets
@@ -190,8 +190,11 @@ export class FeedService {
 
   async getFeedsWithCounts(): Promise<Feed[]> {
     const feeds: Feed[] = await this.db.getAllFeeds();
+    // 一次 GROUP BY 查询取出所有订阅源的未读数，避免逐源 COUNT 的 N+1 查询
+    const counts: Map<number, number> = await this.db.getUnreadCountsByFeed();
     for (const feed of feeds) {
-      feed.unreadCount = await this.db.getUnreadCount(feed.id, -1);
+      const count: number | undefined = counts.get(feed.id);
+      feed.unreadCount = count !== undefined ? count : 0;
     }
     return feeds;
   }
