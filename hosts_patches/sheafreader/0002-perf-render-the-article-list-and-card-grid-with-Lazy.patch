Date: Wed, 23 Sep 2026 13:06:01 +0800
Subject: [PATCH 2/5] perf: render the article list and card grid with
 LazyForEach over a data source so off-screen articles are not built eagerly

---
 .../main/ets/components/ArticleListView.ets   | 52 +++++++++++++++++--
 1 file changed, 49 insertions(+), 3 deletions(-)

diff --git a/entry/src/main/ets/components/ArticleListView.ets b/entry/src/main/ets/components/ArticleListView.ets
index 6fd18dd..223c3e4 100644
--- a/entry/src/main/ets/components/ArticleListView.ets
+++ b/entry/src/main/ets/components/ArticleListView.ets
@@ -59,9 +59,55 @@ struct ChipView {
  * `MagazineCard` / `CompactCard` — and every layout honours the same
  * `ViewConfigs` bits, which is what makes "Customised" meaningful.
  */
+/**
+ * Lazy data source for the article list: rows are created only when they
+ * enter the viewport instead of eagerly for every loaded article.
+ */
+class ArticleDataSource implements IDataSource {
+  private articles: Article[] = [];
+  private listeners: DataChangeListener[] = [];
+
+  totalCount(): number {
+    return this.articles.length;
+  }
+
+  getData(index: number): Article {
+    return this.articles[index];
+  }
+
+  registerDataChangeListener(listener: DataChangeListener): void {
+    if (this.listeners.indexOf(listener) < 0) {
+      this.listeners.push(listener);
+    }
+  }
+
+  unregisterDataChangeListener(listener: DataChangeListener): void {
+    const pos: number = this.listeners.indexOf(listener);
+    if (pos >= 0) {
+      this.listeners.splice(pos, 1);
+    }
+  }
+
+  setArticles(articles: Article[]): void {
+    this.articles = articles;
+    this.listeners.forEach((listener: DataChangeListener) => {
+      listener.onDataReloaded();
+    });
+  }
+}
+
 @Component
 export struct ArticleListView {
-  @ObjectLink store: AppStore;
+  @ObjectLink @Watch('onStoreArticlesChanged') store: AppStore;
+  private articleDataSource: ArticleDataSource = new ArticleDataSource();
+
+  aboutToAppear(): void {
+    this.articleDataSource.setArticles(this.store.articles);
+  }
+
+  onStoreArticlesChanged(): void {
+    this.articleDataSource.setArticles(this.store.articles);
+  }
   /** Width of this pane, used to size the card grid. */
   @Prop paneWidth: number;
   onArticleSelect: (articleId: number) => void = () => {
@@ -802,7 +848,7 @@ export struct ArticleListView {
         .justifyContent(FlexAlign.Center)
       } else if (this.store.viewType === ViewType.Cards) {
         Grid() {
-          ForEach(this.store.articles, (article: Article) => {
+          LazyForEach(this.articleDataSource, (article: Article) => {
             GridItem() {
               Column() {
                 GridCard({
@@ -844,7 +890,7 @@ export struct ArticleListView {
         .scrollBar(BarState.Auto)
       } else {
         List() {
-          ForEach(this.store.articles, (article: Article) => {
+          LazyForEach(this.articleDataSource, (article: Article) => {
             ListItem() {
               Column() {
                 if (this.store.viewType === ViewType.Compact) {
