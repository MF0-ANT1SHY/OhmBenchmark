From f62858e1ca337cbc1d128cec51917d792c3f4c68 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:55:43 +0800
Subject: [PATCH 1/5] perf: locate closing tags with a case-insensitive regex
 instead of lowercasing a copy of the whole fragment per extracted tag

---
 entry/src/main/ets/utils/FeedParser.ets | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/entry/src/main/ets/utils/FeedParser.ets b/entry/src/main/ets/utils/FeedParser.ets
index bf93d74..a47bd8b 100644
--- a/entry/src/main/ets/utils/FeedParser.ets
+++ b/entry/src/main/ets/utils/FeedParser.ets
@@ -184,13 +184,16 @@ export class FeedParser {
     }
 
     const innerStart: number = openMatch.index + openMatch[0].length;
-    const closeTag: string = '</'.concat(tagName.toLowerCase()).concat('>');
-    const closeIndex: number = xml.toLowerCase().indexOf(closeTag, innerStart);
-    if (closeIndex < 0) {
+    // 用大小写不敏感的正则定位闭合标签，避免为每次取值都物化整段小写拷贝
+    const closeRegex: RegExp = new RegExp('</'.concat(tagName).concat('\\s*>'), 'i');
+    closeRegex.lastIndex = 0;
+    const rest: string = xml.substring(innerStart);
+    const closeMatch: RegExpExecArray | null = closeRegex.exec(rest);
+    if (closeMatch === null) {
       return '';
     }
 
-    const inner: string = xml.substring(innerStart, closeIndex);
+    const inner: string = rest.substring(0, closeMatch.index);
     return FeedParser.joinCdata(inner).trim();
   }
 
