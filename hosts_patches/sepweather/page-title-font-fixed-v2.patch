diff --git a/entry/src/main/ets/common/utils/PageTitleFont.ets b/entry/src/main/ets/common/utils/PageTitleFont.ets
new file mode 100644
index 0000000..90a3ff7
--- /dev/null
+++ b/entry/src/main/ets/common/utils/PageTitleFont.ets
@@ -0,0 +1,13 @@
+import { font } from '@kit.ArkUI';
+
+const family = 'PageTitle';
+let registered = false;
+
+// All page titles share the same immutable bundled font.
+export function registerPageTitleFont(): string {
+  if (!registered) {
+    font.registerFont({ familyName: family, familySrc: $rawfile('DroidSansFallbackFull.ttf') });
+    registered = true;
+  }
+  return family;
+}
