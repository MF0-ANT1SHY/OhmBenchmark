@@ -0,0 +1,42 @@
+import { SongProps } from './song'
+
+export interface HistoryEntry {
+  key: string
+  song: SongProps
+}
+
+export class HistoryDataSource implements IDataSource {
+  private keys: string[] = []
+  private entries: Map<string, HistoryEntry> = new Map<string, HistoryEntry>()
+  private listeners: DataChangeListener[] = []
+
+  setHistory(history: Set<string>): void {
+    this.keys = Array.from(history).reverse()
+    this.entries.forEach((_entry: HistoryEntry, key: string) => {
+      if (!history.has(key)) this.entries.delete(key)
+    })
+    this.listeners.forEach((listener: DataChangeListener) => listener.onDataReloaded())
+  }
+
+  totalCount(): number {
+    return this.keys.length
+  }
+
+  getData(index: number): HistoryEntry {
+    const key: string = this.keys[index]
+    const existing: HistoryEntry | undefined = this.entries.get(key)
+    if (existing) return existing
+    const entry: HistoryEntry = { key: key, song: JSON.parse(key) as SongProps }
+    this.entries.set(key, entry)
+    return entry
+  }
+
+  registerDataChangeListener(listener: DataChangeListener): void {
+    if (this.listeners.indexOf(listener) < 0) this.listeners.push(listener)
+  }
+
+  unregisterDataChangeListener(listener: DataChangeListener): void {
+    const index: number = this.listeners.indexOf(listener)
+    if (index >= 0) this.listeners.splice(index, 1)
+  }
+}
