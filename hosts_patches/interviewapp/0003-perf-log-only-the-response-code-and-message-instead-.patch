From 4fd37562f8060ce572f580d89dbf9d3a33052e63 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:57:19 +0800
Subject: [PATCH 3/4] perf: log only the response code and message instead of
 JSON.stringify-ing the whole response body to truncate it to 200 chars

---
 commons/basic/src/main/ets/utils/request.ets | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/commons/basic/src/main/ets/utils/request.ets b/commons/basic/src/main/ets/utils/request.ets
index 4efe368..fe7f4f7 100644
--- a/commons/basic/src/main/ets/utils/request.ets
+++ b/commons/basic/src/main/ets/utils/request.ets
@@ -54,7 +54,8 @@ class HdHttp {
       if (res.result) {
         const result = res.result as HdResponse<T>
         if (result.code === 10000) {
-          logger.info(fullUrl, JSON.stringify(res.result).substring(0, 200))
+          // 只记录响应摘要字段，避免为日志序列化整个响应体
+          logger.info(fullUrl, `code=${result.code} message=${result.message ?? ''}`)
           return result
         }
         if (result.code === 401) {
-- 
