From 9f226e3d8793bf1a9396221d5c518debd7b8bde5 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:06:49 +0800
Subject: [PATCH 4/4] perf: keep search history as a bounded, ordered list (max
 20 entries) instead of an ever-growing key set

---
 features/home/src/main/ets/utils/history.ets | 36 ++++++++++++++++----
 1 file changed, 29 insertions(+), 7 deletions(-)

diff --git a/features/home/src/main/ets/utils/history.ets b/features/home/src/main/ets/utils/history.ets
index 375d60d..b451639 100644
--- a/features/home/src/main/ets/utils/history.ets
+++ b/features/home/src/main/ets/utils/history.ets
@@ -1,7 +1,10 @@
 import { preferences } from '@kit.ArkData'
 
 class HistoryStore {
+  // 搜索历史上限：只保留最近的若干条，避免关键词无上限累积导致读写放大
+  private static readonly MAX_ENTRIES: number = 20
   KEY = 'historyStore'
+  LIST_KEY = 'keywords'
   store = preferences.getPreferencesSync(getContext(), { name: this.KEY })
   // 落盘做防抖：连续写入时只在停止修改后统一 flush，避免每次搜索都同步刷盘
   private flushTimer: number = -1
@@ -16,14 +19,34 @@ class HistoryStore {
     }, 2000)
   }
 
-  setItem(keyword: string) {
-    this.store.putSync(keyword, keyword)
+  private readList(): string[] {
+    const raw: string = this.store.getSync(this.LIST_KEY, '[]') as string
+    try {
+      const parsed: object = JSON.parse(raw) as object
+      if (Array.isArray(parsed)) {
+        return parsed as string[];
+      }
+    } catch (err) {
+    }
+    return [];
+  }
+
+  private writeList(list: string[]) {
+    this.store.putSync(this.LIST_KEY, JSON.stringify(list))
     this.scheduleFlush()
   }
 
+  setItem(keyword: string) {
+    const list: string[] = this.readList().filter((item: string) => item !== keyword)
+    list.unshift(keyword)
+    if (list.length > HistoryStore.MAX_ENTRIES) {
+      list.length = HistoryStore.MAX_ENTRIES
+    }
+    this.writeList(list)
+  }
+
   delItem(keyword: string) {
-    this.store.deleteSync(keyword)
-    this.scheduleFlush()
+    this.writeList(this.readList().filter((item: string) => item !== keyword))
   }
 
   clear() {
@@ -31,9 +54,8 @@ class HistoryStore {
     this.scheduleFlush()
   }
 
-  getAll() {
-    const obj = this.store.getAllSync()
-    return Object.keys(obj)
+  getAll(): string[] {
+    return this.readList()
   }
 }
 
-- 
