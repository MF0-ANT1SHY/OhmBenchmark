From cb8a8ea61b6b0fc4d744d7ec9298f0a391910e12 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:04:45 +0800
Subject: [PATCH 4/4] perf: log web page load progress only at milestones
 instead of on every high-frequency progress event

---
 entry/src/main/ets/pages/WebPage.ets | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/entry/src/main/ets/pages/WebPage.ets b/entry/src/main/ets/pages/WebPage.ets
index 4c3aa28..a637766 100644
--- a/entry/src/main/ets/pages/WebPage.ets
+++ b/entry/src/main/ets/pages/WebPage.ets
@@ -59,7 +59,10 @@ struct WebPage {
 
           })
           .onProgressChange(event => {
-            log(`onProgressChange progress: ${event.newProgress}`, "WebPage")
+            // 进度事件触发非常频繁，仅在里程碑处记录日志，避免日志风暴拖慢页面加载
+            if (event.newProgress === 100 || event.newProgress % 25 === 0) {
+              log(`onProgressChange progress: ${event.newProgress}`, "WebPage")
+            }
           })
           .onPageEnd(event => {
             log(`onPageEnd url: ${event.url}`, "WebPage")
-- 
