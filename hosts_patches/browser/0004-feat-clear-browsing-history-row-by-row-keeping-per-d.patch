From 28a458b77ab36012e74f8f4c80b4d565a85cf07b Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:38:51 +0800
Subject: [PATCH 4/6] feat: clear browsing history row by row, keeping per-day
 table schema after cleanup

---
 entry/src/main/ets/utils/RdbUtils.ets | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/entry/src/main/ets/utils/RdbUtils.ets b/entry/src/main/ets/utils/RdbUtils.ets
index 3be36c2..5f3c789 100644
--- a/entry/src/main/ets/utils/RdbUtils.ets
+++ b/entry/src/main/ets/utils/RdbUtils.ets
@@ -166,12 +166,23 @@ export default class RdbUtils {
 
   static async deleteAll() {
     const dateList: string[] = await RdbUtils.queryAllDate()
-    dateList.forEach((date: string) => {
-      const sql = `DROP TABLE IF EXISTS ${date}`
-      RdbUtils.executeSql(sql)
-    })
-
-    RdbUtils.executeSql(`DROP TABLE IF EXISTS date_table`)
+    for (const date of dateList) {
+      const tableName = "history_" + date
+      // 逐条删除各日期分表中的浏览记录
+      let resultSet: relationalStore.ResultSet | null = null
+      try {
+        resultSet = await RdbUtils.getStore().querySql(`SELECT id FROM ${tableName}`)
+        while (resultSet.goToNextRow()) {
+          const id = resultSet.getLong(resultSet.getColumnIndex("id"))
+          await RdbUtils.getStore().executeSql(`DELETE FROM ${tableName} WHERE id = ${id}`)
+        }
+      } catch (error) {
+        console.error(`清理历史记录异常： ${error.code}，失败信息： ${error.message}`)
+      } finally {
+        resultSet?.close()
+      }
+      await RdbUtils.getStore().executeSql(`DELETE FROM date_table WHERE date = '${date}'`)
+    }
 
     RdbUtils.knownDates.clear()
   }
-- 
