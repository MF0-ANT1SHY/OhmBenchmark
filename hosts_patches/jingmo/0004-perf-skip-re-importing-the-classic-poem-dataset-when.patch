From 6d6ad777f109124852e5c2374ea77edfc2347cea Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 13:09:34 +0800
Subject: [PATCH 4/4] perf: skip re-importing the classic-poem dataset when it
 is already present instead of re-running the full import on every sync-page
 open

---
 .../src/main/ets/database/ClassicPoemDao.ets  | 20 +++++++++++++++++++
 .../main/ets/viewmodel/DatasetViewModel.ets   |  6 ++++++
 2 files changed, 26 insertions(+)

diff --git a/features/classicalliterature/classicpoem/src/main/ets/database/ClassicPoemDao.ets b/features/classicalliterature/classicpoem/src/main/ets/database/ClassicPoemDao.ets
index 0efecc8..960b802 100644
--- a/features/classicalliterature/classicpoem/src/main/ets/database/ClassicPoemDao.ets
+++ b/features/classicalliterature/classicpoem/src/main/ets/database/ClassicPoemDao.ets
@@ -69,6 +69,26 @@ export class  ClassicPoemDao {
     }
   }
 
+  // 查询数据集是否已导入（数量大于 0）
+  async countClassicPoems(): Promise<number> {
+    let count: number = 0
+    await DbUtil.objectiveRDB?.querySql(`select count(*) as cnt from ${DbTableConst.ClassicPoemTable}`)
+      .then((resultSet: relationalStore.ResultSet) => {
+        try {
+          if (resultSet.goToNextRow()) {
+            count = resultSet.getLong(resultSet.getColumnIndex('cnt'))
+          }
+        } catch (error) {
+          let err = error as BusinessError
+          this.logger.error(`Count is failed, code is ${err.code},message is ${err.message}`)
+        }
+        return count
+      }).catch((err: BusinessError) => {
+        this.logger.error(`Count is failed, code is ${err.code},message is ${err.message}`)
+      })
+    return count
+  }
+
   async readRandomClassicPoem(): Promise<ClassicPoem | null> {
     let classicPoem: ClassicPoem | null = null
 
diff --git a/features/settings/src/main/ets/viewmodel/DatasetViewModel.ets b/features/settings/src/main/ets/viewmodel/DatasetViewModel.ets
index 17ec4c0..69c65a4 100644
--- a/features/settings/src/main/ets/viewmodel/DatasetViewModel.ets
+++ b/features/settings/src/main/ets/viewmodel/DatasetViewModel.ets
@@ -53,6 +53,12 @@ class DatasetViewModel {
   }
 
   async insertClassicPoemsToDb(classicPoems: ClassicPoem[]){
+    // 数据集已导入过则跳过全量重复导入（当前数据集为静态版本，重复导入只会全部冲突）
+    const existing: number = await this.classicPoemDao.countClassicPoems()
+    if (existing > 0) {
+      this.logger.info(`dataset already imported (${existing} rows), skip import`)
+      return
+    }
     await this.classicPoemDao.createClassicPoems(classicPoems).catch((error: BusinessError) => {
       this.logger.error(`insertClassicPoemsToDb error, code = :${error.code}, message = ${error.message}`)
     })
-- 
