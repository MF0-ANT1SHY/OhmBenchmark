From 3eb76867d44a6833067234e96ee12dce669940e7 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:25:19 +0800
Subject: [PATCH 1/4] build: downgrade hvigor modelVersion/targetSdk to
 5.1.0(API18) and drop API19-only toolbar option for headless build

---
 build-profile.json5                                           | 2 +-
 .../classicpoem/src/main/ets/pages/ClassicPoem.ets            | 4 +---
 hvigor/hvigor-config.json5                                    | 2 +-
 oh-package.json5                                              | 2 +-
 4 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/build-profile.json5 b/build-profile.json5
index 9e9b42a..d6d91ab 100644
--- a/build-profile.json5
+++ b/build-profile.json5
@@ -5,7 +5,7 @@
       {
         "name": "default",
         "signingConfig": "default",
-        "targetSdkVersion": "6.0.1(21)",
+        "targetSdkVersion": "5.1.0(18)",
         "compatibleSdkVersion": "5.0.5(17)",
         "runtimeOS": "HarmonyOS",
         "buildOption": {
diff --git a/features/classicalliterature/classicpoem/src/main/ets/pages/ClassicPoem.ets b/features/classicalliterature/classicpoem/src/main/ets/pages/ClassicPoem.ets
index b4fb005..c8a037f 100644
--- a/features/classicalliterature/classicpoem/src/main/ets/pages/ClassicPoem.ets
+++ b/features/classicalliterature/classicpoem/src/main/ets/pages/ClassicPoem.ets
@@ -76,9 +76,7 @@ export struct ClassicPoem {
         "icon": Icon.ic_public_refresh,
         "action": () => { this.refresh() }
       }
-    ], {
-      "hideItemValue": true
-    })
+    ])
     .onReady((ctx: NavDestinationContext) => {
       this.pageStack = ctx.pathStack
     })
diff --git a/hvigor/hvigor-config.json5 b/hvigor/hvigor-config.json5
index 3729371..aa5edd6 100644
--- a/hvigor/hvigor-config.json5
+++ b/hvigor/hvigor-config.json5
@@ -1,5 +1,5 @@
 {
-  "modelVersion": "6.0.1",
+  "modelVersion": "5.1.0",
   "dependencies": {
   },
   "execution": {
diff --git a/oh-package.json5 b/oh-package.json5
index e833b19..6bc882d 100644
--- a/oh-package.json5
+++ b/oh-package.json5
@@ -1,5 +1,5 @@
 {
-  "modelVersion": "6.0.1",
+  "modelVersion": "5.1.0",
   "description": "Please describe the basic information.",
   "dependencies": {
   },
-- 
