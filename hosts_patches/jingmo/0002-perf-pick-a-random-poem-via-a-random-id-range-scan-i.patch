From caf08237364b16bdda9a9be5ade0beae37d7f487 Mon Sep 17 00:00:00 2001
From: mike <dust@to.com>
Date: Wed, 23 Sep 2026 12:45:30 +0800
Subject: [PATCH 2/4] perf: pick a random poem via a random id range scan
 instead of order by random() which sorts the whole table on every refresh

---
 commons/constants/src/main/ets/DbConst.ets | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/commons/constants/src/main/ets/DbConst.ets b/commons/constants/src/main/ets/DbConst.ets
index defd91a..03bc744 100644
--- a/commons/constants/src/main/ets/DbConst.ets
+++ b/commons/constants/src/main/ets/DbConst.ets
@@ -26,7 +26,9 @@ export class DbMigrationConst {
 }
 
 export class DbCRUDConst {
+  // 通过随机 id 区间定位代替 order by random() 的全表排序，避免随数据量线性增长的查询耗时
   static readonly READ_RANDOM_CLASSICPOEM: string =
     'select * from ' + DbTableConst.ClassicPoemTable +
-      ' where id = (select p.id from classicalliterature_classicpoem p order by random() limit 1) limit 1';
+      ' where id >= (abs(random()) % (select max(id) from ' + DbTableConst.ClassicPoemTable + '))' +
+      ' order by id limit 1';
 }
\ No newline at end of file
