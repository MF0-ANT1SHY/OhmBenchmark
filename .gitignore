# SDK/toolchain checkout; a symlink here, so anchor without a trailing
# slash (git does not follow it when matching)
/toolchain
hosts/*/
*.log
# Raw measurement data lives outside the repository (see DATA.md):
#   /home/research/OhmBenchmark-data/{measurements,experiments}
# These are repo-root symlinks to that directory; anchor without a trailing
# slash so the symlink itself is matched (git does not follow it).
/measurements
/experiments

# Fresh collection goes here; the original evidence lives in the data directory
# (see DATA.md) and must never be overwritten by a new session.
measurements-staging/
measurements-staging-v2/

__pycache__/
