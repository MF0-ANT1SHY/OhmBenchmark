diff --git a/entry/src/main/ets/utils/CloudBench.ets b/entry/src/main/ets/utils/CloudBench.ets
new file mode 100644
index 0000000..b506b45
--- /dev/null
+++ b/entry/src/main/ets/utils/CloudBench.ets
@@ -0,0 +1,23 @@
+import { common } from '@kit.AbilityKit';
+import { relationalStore } from '@kit.ArkData';
+import { Artist } from '../common/entities/song/Song';
+import { getArtists } from '../common/functions/common/convert';
+import RelationalStoreUtils from '../common/utils/data/RelationalStoreUtils';
+import { OhmProbe } from './OhmProbe';
+export async function runCloudBench(context: common.UIAbilityContext,name: string): Promise<void> {
+  if (name==='cloudmusic_local_song_memory_filter') {
+    await RelationalStoreUtils.init();
+    const db=await relationalStore.getRdbStore(context,{name:'LocalSongs.db',securityLevel:relationalStore.SecurityLevel.S1});
+    await db.executeSql('DELETE FROM songs');
+    await db.executeSql("WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM n WHERE x<1000) INSERT INTO songs(songId,name,artists,songFile,picFile,lyricFile) SELECT x,'Song '||x,'Artist','/music/song-'||printf('%05d',x)||'.flac','','' FROM n");
+    AppStorage.SetOrCreate('ohmLocalBench',true);
+    return;
+  }
+  const artists: Artist[]=[];
+  for (let i=0;i<5;i++) artists.push({id:i,name:'Artist '+i});
+  await OhmProbe.measure(context,name,async (): Promise<void> => {},async (): Promise<number> => {
+    let count=0;
+    for (let i=0;i<100000;i++) count+=getArtists(artists).length;
+    return count;
+  });
+}
diff --git a/entry/src/main/ets/utils/OhmProbe.ets b/entry/src/main/ets/utils/OhmProbe.ets
new file mode 100644
index 0000000..d37c5ea
--- /dev/null
+++ b/entry/src/main/ets/utils/OhmProbe.ets
@@ -0,0 +1,36 @@
+import fs from '@ohos.file.fs';
+import systemDateTime from '@ohos.systemDateTime';
+import hiTraceMeter from '@ohos.hiTraceMeter';
+import { common } from '@kit.AbilityKit';
+
+export class OhmProbe {
+  static write(context: common.UIAbilityContext, value: string): void {
+    const file = fs.openSync(context.filesDir + '/ohm-status.json', fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
+    fs.writeSync(file.fd, value);
+    fs.closeSync(file);
+  }
+
+  static async measure(context: common.UIAbilityContext, name: string,
+    prepare: () => Promise<void>, action: () => Promise<number>): Promise<void> {
+    try {
+      OhmProbe.write(context, '{"state":"preparing"}');
+      await prepare();
+      const go = context.filesDir + '/ohm-go';
+      if (fs.accessSync(go)) fs.unlinkSync(go);
+      OhmProbe.write(context, '{"state":"ready"}');
+      await new Promise<void>((resolve) => {
+        const timer = setInterval(() => {
+          if (fs.accessSync(go)) { clearInterval(timer); resolve(); }
+        }, 100);
+      });
+      hiTraceMeter.startTrace('OHMB/' + name, 1);
+      const start = systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true);
+      const result = await action();
+      const elapsed = (systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true) - start) / 1000000;
+      hiTraceMeter.finishTrace('OHMB/' + name, 1);
+      OhmProbe.write(context, '{"state":"done","case":"' + name + '","elapsed_ms":' + elapsed + ',"result":' + result + '}');
+    } catch (e) {
+      OhmProbe.write(context, '{"state":"error","message":' + JSON.stringify(String(e)) + '}');
+    }
+  }
+}
