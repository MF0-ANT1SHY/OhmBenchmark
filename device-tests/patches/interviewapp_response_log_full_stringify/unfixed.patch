new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/features/home/src/main/ets/utils/Diag.ets
@@ -0,0 +1,27 @@
+import fs from '@ohos.file.fs';
+import { common } from '@kit.AbilityKit';
+
+/**
+ * Append-only diagnostic log, separate from `ohm-status.json`.
+ *
+ * The status file is overwritten by the state machine (`ready`, then `done`), so a diagnostic
+ * written into it during `prepare()` is destroyed within milliseconds. That is exactly what
+ * happened when the bench tried to report what the history page saw, and it left the
+ * parse-counter reading of 0 ambiguous between "the page never built its rows" and "the bench
+ * read a different module instance than the page writes".
+ *
+ * This file is only ever appended to, so every checkpoint survives until it is read.
+ */
+export class Diag {
+  static log(context: common.UIAbilityContext, label: string, value: string): void {
+    try {
+      const path = context.filesDir + '/ohm-diag.json';
+      const line = '{"t":"' + label + '","v":' + JSON.stringify(value) + '}\n';
+      const file = fs.openSync(path, fs.OpenMode.CREATE | fs.OpenMode.APPEND | fs.OpenMode.WRITE_ONLY);
+      fs.writeSync(file.fd, line);
+      fs.closeSync(file);
+    } catch (e) {
+      // diagnostics must never break the measurement
+    }
+  }
+}
diff --git a/features/home/src/main/ets/utils/InterviewBench.ets b/features/home/src/main/ets/utils/InterviewBench.ets
new file mode 100644
index 0000000..413e700
--- /dev/null
+++ b/features/home/src/main/ets/utils/InterviewBench.ets
@@ -0,0 +1,37 @@
+import { common } from '@kit.AbilityKit';
+import { historyStore } from './history';
+import { ohmHttp } from '@itcast/basic';
+import { OhmProbe } from './OhmProbe';
+import { ohmResponseStringifyReset, ohmResponseStringifyTotal, ohmDiag } from '@itcast/basic';
+
+interface FixtureRow { id: number; title: string; description: string; }
+export async function runInterviewBench(context: common.UIAbilityContext, name: string): Promise<void> {
+  await OhmProbe.measure(context, name, async (): Promise<void> => {
+    if (name === 'interviewapp_response_log_full_stringify') {
+      ohmHttp.baseURL = 'http://127.0.0.1:18766/';
+      return;
+    }
+    historyStore.clear();
+    if (name === 'interviewapp_search_history_unbounded') {
+      for (let i=0;i<5000;i++) historyStore.setItem('HarmonyOS interview question '+i);
+    }
+    await new Promise<void>((resolve) => { setTimeout(resolve, 2500); });
+  }, async (): Promise<number> => {
+    if (name === 'interviewapp_search_history_unbounded') {
+      let total=0;
+      for (let i=0;i<100;i++) total+=historyStore.getAll().length;
+      return total;
+    }
+    if (name === 'interviewapp_response_log_full_stringify') {
+      ohmResponseStringifyReset();
+      let total=0;
+      for (let i=0;i<5;i++) {
+        const response = await ohmHttp.get<FixtureRow[]>('response');
+        total+=response.data.length;
+      }
+      const stringifies = ohmResponseStringifyTotal();
+      ohmDiag(context, 'after-wait', 'calls=5 serializes=' + stringifies +
+        ' rowsPerResponse=' + (total / 5));
+      return stringifies;
+    }
+    for (let i=0;i<1000;i++) historyStore.setItem('HarmonyOS interview question '+i);
+    // Include the application's own deferred flush (2 seconds) in both windows.
+    await new Promise<void>((resolve) => { setTimeout(resolve, 3000); });
+    return historyStore.getAll().length;
+  });
+}
diff --git a/features/home/src/main/ets/utils/OhmProbe.ets b/features/home/src/main/ets/utils/OhmProbe.ets
new file mode 100644
index 0000000..d37c5ea
--- /dev/null
+++ b/features/home/src/main/ets/utils/OhmProbe.ets
@@ -0,0 +1,36 @@
+import fs from '@ohos.file.fs';
+import systemDateTime from '@ohos.systemDateTime';
+import hiTraceMeter from '@ohos.hiTraceMeter';
+import { common } from '@kit.AbilityKit';
+
+export class OhmProbe {
+  static write(context: common.UIAbilityContext, value: string): void {
+    const file = fs.openSync(context.filesDir + '/ohm-status.json', fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
+    fs.writeSync(file.fd, value);
+    fs.closeSync(file);
+  }
+
+  static async measure(context: common.UIAbilityContext, name: string,
+    prepare: () => Promise<void>, action: () => Promise<number>): Promise<void> {
+    try {
+      OhmProbe.write(context, '{"state":"preparing"}');
+      await prepare();
+      const go = context.filesDir + '/ohm-go';
+      if (fs.accessSync(go)) fs.unlinkSync(go);
+      OhmProbe.write(context, '{"state":"ready"}');
+      await new Promise<void>((resolve) => {
+        const timer = setInterval(() => {
+          if (fs.accessSync(go)) { clearInterval(timer); resolve(); }
+        }, 100);
+      });
+      hiTraceMeter.startTrace('OHMB/' + name, 1);
+      const start = systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true);
+      const result = await action();
+      const elapsed = (systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true) - start) / 1000000;
+      hiTraceMeter.finishTrace('OHMB/' + name, 1);
+      OhmProbe.write(context, '{"state":"done","case":"' + name + '","elapsed_ms":' + elapsed + ',"result":' + result + '}');
+    } catch (e) {
+      OhmProbe.write(context, '{"state":"error","message":' + JSON.stringify(String(e)) + '}');
+    }
+  }
+}
