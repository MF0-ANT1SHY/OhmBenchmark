diff --git a/products/default/src/main/ets/utils/JingmoBench.ets b/products/default/src/main/ets/utils/JingmoBench.ets
new file mode 100644
index 0000000..452c99a
--- /dev/null
+++ b/products/default/src/main/ets/utils/JingmoBench.ets
@@ -0,0 +1,30 @@
+import { common } from '@kit.AbilityKit';
+import { OhmProbe } from './OhmProbe';
+import DbUtil from 'utils/src/main/ets/database/DbUtil';
+import { ClassicPoem, ClassicPoemDao } from 'classicalliterature_classicpoem';
+import { DbTableConst } from 'constants';
+// EXTRA_IMPORT
+
+export async function runJingmoBench(context: common.UIAbilityContext, name: string): Promise<void> {
+  const poems: ClassicPoem[] = [];
+  const dao = new ClassicPoemDao();
+  await OhmProbe.measure(context, name, async (): Promise<void> => {
+    const store = DbUtil.objectiveRDB;
+    if (!store) throw new Error('Database unavailable');
+    await store.executeSql('DELETE FROM ' + DbTableConst.ClassicPoemTable);
+    const columns = 'id,dynasty,writer,writer_introduction,title,subtitle,preface,content,annotation,translation,creative_background,explain,comment,collection,category';
+    if (name !== 'jingmo_dataset_import_no_transaction') {
+      await store.executeSql('WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM n WHERE x<50000) INSERT INTO ' + DbTableConst.ClassicPoemTable + '(' + columns + ") SELECT x,'唐','李白','','诗歌 '||x,'','','床前明月光，疑是地上霜。举头望明月，低头思故乡。','','','','','','唐诗','诗歌' FROM n");
+    }
+    if (name !== 'jingmo_random_poem_orderby_random') {
+      const count = name === 'jingmo_dataset_import_no_transaction' ? 3000 : 50000;
+      for (let i=1;i<=count;i++) {
+        poems.push(new ClassicPoem(i,'唐','李白','','诗歌 '+i,'','','床前明月光，疑是地上霜。举头望明月，低头思故乡。','','','','','','唐诗','诗歌'));
+      }
+    }
+  }, async (): Promise<number> => {
+    let count=0;
+    for (let i=0;i<10;i++) { const poem = await dao.readRandomClassicPoem(); if (poem !== null) count++; }
+    return count;
+  });
+}
diff --git a/products/default/src/main/ets/utils/OhmProbe.ets b/products/default/src/main/ets/utils/OhmProbe.ets
new file mode 100644
index 0000000..d37c5ea
--- /dev/null
+++ b/products/default/src/main/ets/utils/OhmProbe.ets
@@ -0,0 +1,36 @@
+import fs from '@ohos.file.fs';
+import systemDateTime from '@ohos.systemDateTime';
+import hiTraceMeter from '@ohos.hiTraceMeter';
+import { common } from '@kit.AbilityKit';
+
+export class OhmProbe {
+  static write(context: common.UIAbilityContext, value: string): void {
+    const file = fs.openSync(context.filesDir + '/ohm-status.json', fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
+    fs.writeSync(file.fd, value);
+    fs.closeSync(file);
+  }
+
+  static async measure(context: common.UIAbilityContext, name: string,
+    prepare: () => Promise<void>, action: () => Promise<number>): Promise<void> {
+    try {
+      OhmProbe.write(context, '{"state":"preparing"}');
+      await prepare();
+      const go = context.filesDir + '/ohm-go';
+      if (fs.accessSync(go)) fs.unlinkSync(go);
+      OhmProbe.write(context, '{"state":"ready"}');
+      await new Promise<void>((resolve) => {
+        const timer = setInterval(() => {
+          if (fs.accessSync(go)) { clearInterval(timer); resolve(); }
+        }, 100);
+      });
+      hiTraceMeter.startTrace('OHMB/' + name, 1);
+      const start = systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true);
+      const result = await action();
+      const elapsed = (systemDateTime.getUptime(systemDateTime.TimeType.STARTUP, true) - start) / 1000000;
+      hiTraceMeter.finishTrace('OHMB/' + name, 1);
+      OhmProbe.write(context, '{"state":"done","case":"' + name + '","elapsed_ms":' + elapsed + ',"result":' + result + '}');
+    } catch (e) {
+      OhmProbe.write(context, '{"state":"error","message":' + JSON.stringify(String(e)) + '}');
+    }
+  }
+}
