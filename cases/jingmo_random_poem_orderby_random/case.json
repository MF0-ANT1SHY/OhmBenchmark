    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Wall time of each random-poem SELECT execution (from query start to resultSet ready, visible in database/disk trace activity and hilog), averaged over 10 refreshes.",
      "comparison": "unfixed query time grows with row count (full scan + sort of N rows); fixed is near-constant. With >= 5000 rows, unfixed_avg_ms > fixed_avg_ms by >= 5x."
    },
    "legacy_instrumented_evidence": {
