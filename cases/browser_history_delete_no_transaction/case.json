    "base_commit": "c42e4b3"
  },
  "android_source_case": "portauthority_oui_import_transactions",
  "android_mechanism": "OUI CSV import commits each row separately; fix batches all inserts into one transaction",
  "category": "latency",
  "bug_description": "Clearing browsing history (settings -> clear history) walks every per-day history table, selects all row IDs and executes one standalone DELETE statement per row, each in its own implicit transaction (autocommit). With hundreds of history entries this causes hundreds of individual journal/fsync cycles, making the clear operation and the following UI freeze noticeably long.",
  "perf_scenarios": [
    "数据库读取",
    "状态更新"
  ],
  "unfixed_commit": "1aa4710ed2aa098f9073e2649868f3559da05e51",
  "fixed_commit": "650ec0b7beab4e28e8c9578ed8651bea05d34d20",
  "fix_summary": "All clear-history DELETE statements are wrapped in a single RDB transaction (beginTransaction/commit with rollback on error): one bulk DELETE per table inside one commit.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_browser_0020",
    "py_file": "testcase/PerfLoad_browser_0020.py",
    "descriptor": "testcase/PerfLoad_browser_0020.json",
    "install_dir": "perf_testing/hapray/testcases/com.example.nanvision",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_browser_0020.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 20,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Time from the clear-button tap event (input dispatch in trace) to completion of the last RDB write observed in disk activity.",
      "comparison": "unfixed shows one sqlite fsync/journal cycle per deleted row; fixed shows a single commit. unfixed_clear_history_wall_time_ms > fixed_clear_history_wall_time_ms by >= 2x with 100+ entries."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        347565564,
        343343678,
        360078374
      ],
      "fixed": [
        4628830,
        4260818,
        5785336
      ],
      "note": "348M vs 4.6M instructions (75x); cpu 2735 vs 28 ms"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py browser_history_delete_no_transaction",
    "python3 tools/sign_clean_cases.py browser_history_delete_no_transaction",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/browser_history_delete_no_transaction/testcase/ into perf_testing/hapray/testcases/com.example.nanvision/.",
    "Install each clean signed variant and run the PerfLoad_browser_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
