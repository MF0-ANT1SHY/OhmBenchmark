  "android_source_case": "fdroid_precomputed_preferred_metadata",
  "android_mechanism": "Preferred repository metadata recomputed for every catalog row; fix precomputes it once",
  "category": "latency",
  "bug_description": "ArticleComponent calls TextUtils.htmlDecode on title, desc and chapterName every time a list item is built. The feed list uses plain ForEach, so opening the home/search/square lists and every re-render during scrolling re-runs 12 replaceAll passes per field across all accumulated items, multiplying decode work on the render path.",
  "perf_scenarios": [
    "列表滑动",
    "网络结果渲染"
  ],
  "unfixed_commit": "dd45ad238328c4ac857992b69fe9457c87c279f3",
  "fixed_commit": "85a73986cd4eee9c04cdbffc96aefc947e1f3bab",
  "fix_summary": "HTML entities are decoded once when article data arrives (TextUtils.decodeArticleList applied in fetchData/search/loadList); list items render the already-decoded fields.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_wanharmony_0020",
    "py_file": "testcase/PerfLoad_wanharmony_0020.py",
    "descriptor": "testcase/PerfLoad_wanharmony_0020.json",
    "install_dir": "perf_testing/hapray/testcases/org.example.wan.ohos",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_wanharmony_0020.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 35,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "scroll_cpu_ms_per_item",
      "definition": "Total CPU time of the app process during the fixed-duration scroll divided by number of rendered items, from hitrace; supplementary: count of string replaceAll invocations in JS stack samples.",
      "comparison": "unfixed shows repeated htmlDecode execution on every item build (visible in JS sampling stacks); fixed executes decode only once per item at fetch. unfixed scroll CPU per item > fixed by >= 15%."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "htmlDecode calls per item",
      "unfixed": [
        3,
        3,
        3
      ],
      "fixed": [
        1,
        1,
        1
      ],
      "note": "3 vs 1 htmlDecode calls per rendered item (mechanism counter, authoritative); whole-step hw-instruction medians sit inside the noise band (3.9M vs 4.4M), so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py wanharmony_html_decode_per_render",
    "python3 tools/sign_clean_cases.py wanharmony_html_decode_per_render",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/wanharmony_html_decode_per_render/testcase/ into perf_testing/hapray/testcases/org.example.wan.ohos/.",
    "Install each clean signed variant and run the PerfLoad_wanharmony_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
