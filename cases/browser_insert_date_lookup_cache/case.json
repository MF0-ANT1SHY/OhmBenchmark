  "android_source_case": "fdroid_category_id_cache",
  "android_mechanism": "Repeated category-ID lookup executed for every imported row; fix caches IDs in memory",
  "category": "latency",
  "bug_description": "Every time a page finishes loading, onSaveHistory -> RdbUtils.insertDate re-queries the date_table for the current date and re-runs CREATE TABLE IF NOT EXISTS for the per-day history table, even though the same date is looked up on every save within a session. The redundant query + DDL run on each page navigation and add avoidable RDB round-trips to the page-save path.",
  "perf_scenarios": [
    "状态更新",
    "数据库读取"
  ],
  "unfixed_commit": "e3c8aa99fd6a93333a9e906216545861aec07456",
  "fixed_commit": "9138921a02aa215e6afb02ec09253c7908babd06",
  "fix_summary": "Cache already-verified per-day tables in an in-memory Set (RdbUtils.knownDates); insertDate returns early on cache hit, and deleteAll clears the cache.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_browser_0040",
    "py_file": "testcase/PerfLoad_browser_0040.py",
    "descriptor": "testcase/PerfLoad_browser_0040.json",
    "install_dir": "perf_testing/hapray/testcases/com.example.nanvision",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_browser_0040.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 30,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "rdb_statements_per_page_save",
      "definition": "Count of RDB statement executions attributable to history saving (date_table SELECT + CREATE TABLE + history INSERT) per page load, from disk/sqlite activity in the hitrace trace or RDB debug logs.",
      "comparison": "unfixed: >= 3 statements per page save after the first (SELECT + CREATE TABLE + INSERT); fixed: 1 statement per page save (INSERT only). Overall page-save wall time in trace drops accordingly."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        980370663,
        930619863,
        988330253
      ],
      "fixed": [
        427037015,
        425730609,
        428455155
      ],
      "note": "980M vs 427M instructions (2.3x); cpu 5949 vs 2495 ms; 3000 vs 1002 statements"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py browser_insert_date_lookup_cache",
    "python3 tools/sign_clean_cases.py browser_insert_date_lookup_cache",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/browser_insert_date_lookup_cache/testcase/ into perf_testing/hapray/testcases/com.example.nanvision/.",
    "Install each clean signed variant and run the PerfLoad_browser_0040 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
