      "rounds_per_variant": 1,
      "required_rounds": 3,
      "full_performance_run_completed": false,
      "performance_accepted": false,
      "legacy_evidence_reused": false,
      "note": "The complete mandatory first pair violates the unchanged all-pairs >=1.2x criterion. Early rejection under the user instruction to skip negatives; not a full three-pair run."
    },
    "mechanism_oracle": {
      "metric": "rdb_statements_per_page_save",
      "definition": "Count of RDB statement executions attributable to history saving (date_table SELECT + CREATE TABLE + history INSERT) per page load, from disk/sqlite activity in the hitrace trace or RDB debug logs.",
      "comparison": "unfixed: >= 3 statements per page save after the first (SELECT + CREATE TABLE + INSERT); fixed: 1 statement per page save (INSERT only). Overall page-save wall time in trace drops accordingly."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        980370663,
        930619863,
        988330253
      ],
      "fixed": [
        427037015,
        425730609,
        428455155
      ],
      "note": "980M vs 427M instructions (2.3x); cpu 5949 vs 2495 ms; 3000 vs 1002 statements"
    }
  },
