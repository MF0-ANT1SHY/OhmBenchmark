  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Wall time of the case action, measured in the app.",
      "comparison": "unfixed re-downloads the whole dataset and re-attempts all inserts (visible network transfer + DB activity); fixed performs one COUNT and no transfer. unfixed network bytes >> fixed (fixed = 0)."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        11506009207,
        11444384089,
        11694505915
      ],
      "fixed": [
        28662204,
        23962817,
        29937028
      ],
      "note": "11.5G vs 28.7M instructions (400x); cpu 1789 vs 123 ms"
    }
  },
