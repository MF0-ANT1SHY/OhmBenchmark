    "evidence": {
      "status": "pending_clean",
      "note": "Both variants receive the identical ordinary dataset-source setting support. Default CDN preserved; native DNS failure diagnosed; full mirror import independently verified. Fresh performance evidence required."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Wall time of the case action, measured in the app.",
      "comparison": "unfixed re-downloads the whole dataset and re-attempts all inserts (visible network transfer + DB activity); fixed performs one COUNT and no transfer. unfixed network bytes >> fixed (fixed = 0)."
    },
    "legacy_instrumented_evidence": {
