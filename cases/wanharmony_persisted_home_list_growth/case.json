  "android_source_case": "dns66_packet_cache_growth",
  "android_mechanism": "Packet-factory properties cache grows without bound; fix bounds the retained data",
  "category": "resource_retention",
  "bug_description": "The home article list is bound to PersistentStorage ('homeList'). Every load-more during infinite scrolling concatenates another page and rewrites the ENTIRE accumulated list (JSON serialization + preferences write) to disk, so persistent-storage write time and retained memory grow quadratically with scroll depth; the full tail is also re-parsed on every cold start even though it is stale feed data.",
  "perf_scenarios": [
    "列表滑动",
    "状态更新"
  ],
  "unfixed_commit": "87d63ec508b1d6ee950f9e5f55c0146bc189b233",
  "fixed_commit": "d1618b99cc613e0333c750137beb833f814c910a",
  "fix_summary": "Only the first-page home-article snapshot is persisted ('homeListCache') for fast cold-start rendering; pages loaded during the session accumulate in component state without rewriting persistent storage.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "MemLoad_wanharmony_0030",
    "py_file": "testcase/MemLoad_wanharmony_0030.py",
    "descriptor": "testcase/MemLoad_wanharmony_0030.json",
    "install_dir": "perf_testing/hapray/testcases/org.example.wan.ohos",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/MemLoad_wanharmony_0030.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf",
      "memory"
    ],
    "step_duration_s": 60,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "app_pss_bytes",
    "definition": "Pss of the app process after the workload, from the periodic smaps_rollup snapshots in memory/.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Three original online twelve-swipe PSS pairs are independently verified; full acceptance still awaits the native ten-page persistence-write mechanism. Legacy instrumented counters are not reused."
    },
    "mechanism_oracle": {
      "metric": "persistent_write_bytes_per_loadmore",
      "definition": "Bytes written to app preferences/storage attributable to home-list persistence per load-more cycle, from disk/filesystem trace activity (write sizes grow with list length in unfixed, stay constant in fixed).",
      "comparison": "unfixed: write size per load-more grows linearly with accumulated pages (total write volume quadratic in pages); fixed: writes only at first-page fetch. unfixed_total_write_bytes > fixed by >= 3x after 10 pages; unfixed resident memory higher."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the load-more persistence workload (Pura 70 Ultra)",
      "unfixed": [
        38880689,
        55970360,
        23187060
      ],
      "fixed": [
        4284000,
        4561975,
        4611977
      ],
      "note": "38.9M vs 4.56M median hw-instructions (8.5x, disjoint ranges, high unfixed variance); mechanism counter 284970 vs 5111 persisted bytes per load-more (measurements-staging)."
    },
    "supplementary_clean_evidence": {
      "status": "offline_cold_cache_verified_not_full_case_acceptance",
      "proof": "../../validation/wan-home-cold-cache-pss-supplement.json",
      "metric": "app_pss_bytes",
