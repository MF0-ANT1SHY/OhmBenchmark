  "android_source_case": "dns66_packet_cache_growth",
  "android_mechanism": "Packet-factory properties cache grows without bound; fix bounds the retained data",
  "category": "resource_retention",
  "bug_description": "The home list is linked to PersistentStorage. Loaded pages accumulate in the persistent homeList as well as the visible session list. Under the normal twelve-swipe workload, the unfixed app retains more process memory than the fixed app, which persists only its first-page snapshot. Whole-preferences file traffic includes cookies and old keys; this case does not claim a 3x reduction in file-write volume or exclusive attribution of those writes.",
  "perf_scenarios": [
    "列表滑动",
    "状态更新"
  ],
  "unfixed_commit": "87d63ec508b1d6ee950f9e5f55c0146bc189b233",
  "fixed_commit": "d1618b99cc613e0333c750137beb833f814c910a",
  "fix_summary": "Persist only the first-page snapshot in homeListCache. Keep later loaded pages in component state. This bounds the active persisted list; it does not eliminate all preferences writes.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
