      ],
      "median_ratio": 1.3694906692312923,
      "rounds_per_variant": 3,
      "required_ratio": 1.3,
      "performance_accepted": true,
      "legacy_evidence_reused": false,
      "new_device_trials": false,
      "note": "Revised memory-and-cache contract. Old file-write negative retained; no write-volume speedup claimed."
    },
    "mechanism_oracle": {
      "metric": "native_home_cache_contents",
      "definition": "Read actual native preference snapshots outside the measured action window. Verify the same first-page IDs and successful sequential load-more responses in each pair. Verify appended article IDs in unfixed homeList and unchanged first-page IDs in fixed homeListCache. Verify shared visible last-page articles.",
      "comparison": "Both variants complete the same normal twelve-swipe workload and successful pages. Unfixed active cache grows to the loaded article list; fixed active cache remains at the original first page. All three native process-PSS ratios and their median must be >=1.3.",
      "not_claimed": [
        "exclusive home-list file-write attribution",
        "3x total file-write reduction",
        "removal of inactive legacy preference keys"
      ]
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the load-more persistence workload (Pura 70 Ultra)",
      "unfixed": [
        38880689,
        55970360,
        23187060
      ],
      "fixed": [
        4284000,
        4561975,
        4611977
      ],
      "note": "38.9M vs 4.56M median hw-instructions (8.5x, disjoint ranges, high unfixed variance); mechanism counter 284970 vs 5111 persisted bytes per load-more (measurements-staging)."
    },
    "supplementary_clean_evidence": {
      "status": "offline_cold_cache_verified_not_full_case_acceptance",
      "proof": "../../validation/wan-home-cold-cache-pss-supplement.json",
      "metric": "app_pss_bytes",
      "median_ratio": 2.9869011000469214,
      "rounds_per_variant": 3,
      "app_injection": false,
      "original_successful_load_more_and_write_volume_pending": false,
      "note": "Historical cold-cache supplement only; revised acceptance uses all three original online pairs, not this larger cold-cache ratio."
    }
  },
