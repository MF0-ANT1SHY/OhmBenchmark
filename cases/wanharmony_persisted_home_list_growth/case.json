  "test_oracle": {
    "metric": "app_pss_bytes",
    "definition": "Pss of the app process after the workload, from the periodic smaps_rollup snapshots in memory/.",
    "comparison": "unfixed >= 1.3 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean",
      "metric": "app_pss_bytes",
      "unfixed": [
        144357376,
        144671744,
        140647424
      ],
      "fixed": [
        105409536,
