+  // 批量导入数据集：使用 batchInsert 在单个事务中完成，避免逐条插入产生的大量独立提交
+  async createClassicPoems(classicPoems: ClassicPoem[]) {
+    const valuesBuckets: relationalStore.ValuesBucket[] = classicPoems.map((classicPoem: ClassicPoem): relationalStore.ValuesBucket => {
+      const bucket: relationalStore.ValuesBucket = {
+        'id': classicPoem.id,
+        'dynasty': classicPoem.dynasty,
+        'writer': classicPoem.writer,
+        'writer_introduction': classicPoem.writer_introduction,
+        'title': classicPoem.title,
+        'subtitle': classicPoem.subtitle,
+        'preface': classicPoem.preface,
+        'content': classicPoem.content,
+        'annotation': classicPoem.annotation,
+        'translation': classicPoem.translation,
+        'creative_background': classicPoem.creative_background,
+        'explain': classicPoem.explain,
+        'comment': classicPoem.comment,
+        'collection': classicPoem.collection,
+        'category': classicPoem.category,
+      }
+      return bucket
+    })
+
+    try {
+      const rowCount = await DbUtil.objectiveRDB?.batchInsert(DbTableConst.ClassicPoemTable, valuesBuckets)
+      this.logger.info(`Batch insert is successful, rowCount = ${rowCount}`)
+    } catch (err) {
+      const error = err as BusinessError
+      this.logger.error(`Batch insert is failed, code is ${error.code},message is ${error.message}`)
+    }
+  }
