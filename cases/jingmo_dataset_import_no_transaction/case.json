  "android_source_case": "portauthority_oui_import_transactions",
  "android_mechanism": "OUI CSV import commits each row separately; fix batches all inserts into one transaction",
  "category": "latency",
  "bug_description": "The dataset-sync page imports the classic-poem dataset by iterating the parsed JSON array and issuing one standalone RDB INSERT per poem (each in its own autocommit transaction, all fired concurrently via a non-awaited map). Importing thousands of rows generates thousands of individual journal/fsync cycles, saturating the DB writer and freezing the sync page for a long time.",
  "perf_scenarios": [
    "数据库读取",
    "网络结果渲染"
  ],
  "unfixed_commit": "caf08237364b16bdda9a9be5ade0beae37d7f487",
  "fixed_commit": "d52c391f23e1f9b1f1f5c1c26989200953eb1f55",
  "fix_summary": "Dataset import uses RdbStore.batchInsert so the whole array is inserted in a single transaction; the per-row debug logging is removed.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_jingmo_0010",
    "py_file": "testcase/PerfLoad_jingmo_0010.py",
    "descriptor": "testcase/PerfLoad_jingmo_0010.json",
    "install_dir": "perf_testing/hapray/testcases/com.hefengbao.jingmo.hw",
    "driver": "DeviceTest",
    "module": "default",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_jingmo_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 60,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Time from dataset JSON parse completion to the last INSERT commit observed in disk/database trace activity.",
      "comparison": "unfixed: one sqlite journal/fsync cycle per row (thousands of small commits); fixed: single batched commit. unfixed_import_ms > fixed_import_ms by >= 3x for a multi-thousand-row dataset."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        1726324143,
        1701604706,
        1751228897
      ],
      "fixed": [
        713365206,
        712671122,
        714310442
      ],
      "note": "1.73G vs 713M instructions (2.4x); cpu 4816 vs 239 ms"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py jingmo_dataset_import_no_transaction",
    "python3 tools/sign_clean_cases.py jingmo_dataset_import_no_transaction",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/jingmo_dataset_import_no_transaction/testcase/ into perf_testing/hapray/testcases/com.hefengbao.jingmo.hw/.",
    "Install each clean signed variant and run the PerfLoad_jingmo_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
