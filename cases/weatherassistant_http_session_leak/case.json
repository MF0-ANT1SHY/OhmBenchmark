{
  "id": "weatherassistant_http_session_leak",
  "host_app": {
    "name": "HarmonyOS-Next-Weather-Assistant",
    "repository": "https://github.com/AlatusLee/HarmonyOS-Next-Weather-Assistant",
    "bundle_name": "com.alatus.futureweather",
    "local_path": "hosts/weatherassistant",
    "base_branch": "ohmbase",
    "base_commit": "167ca48"
  },
  "android_source_case": "portauthority_b311d3140b48",
  "android_mechanism": "Network resource (socket/stream) not released after use; fix closes/releases it",
  "category": "resource_retention",
  "bug_description": "getWeatherUtil.getWeather creates a new http.createHttp() session for every weather request, retains the session and the full response body in the viewmodel, and never calls request.destroy(). Each city refresh leaks an HTTP session plus its complete response for the lifetime of the app, so repeated refreshes and multi-city loads accumulate retained memory.",
  "perf_scenarios": [
    "网络结果渲染",
    "页面切换"
  ],
  "unfixed_commit": "1f787390a703886e69d30ba8968765d363d55a19",
  "fixed_commit": "20e8e16b0c81fd5dee14b636433089cc2796f707",
  "fix_summary": "Sessions are no longer retained after creation, and each request session is destroyed in a finally handler after the response/error callback completes.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "MemLoad_weatherassistant_0010",
    "py_file": "testcase/MemLoad_weatherassistant_0010.py",
    "descriptor": "testcase/MemLoad_weatherassistant_0010.json",
    "install_dir": "perf_testing/hapray/testcases/com.alatus.futureweather",
    "driver": "DeviceTest",
    "module": "alatus",
    "ability": "AlatusAbility",
    "trigger": "external_ui",
    "workload": "testcase/MemLoad_weatherassistant_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf",
      "memory"
    ],
    "step_duration_s": 60,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "nativehook_retained_bytes",
    "definition": "bytes still allocated at step end (malloc/free matching) from the nativehook plugin stream in trace.htrace.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "retained_fds_and_connections",
      "definition": "Growth of the app process fd count and ESTABLISHED/TIME_WAIT socket count attributable to weather requests after N refreshes.",
      "comparison": "unfixed retains roughly one session (fd) per request after requests complete; fixed returns to baseline. unfixed_fd_growth > fixed_fd_growth by >= 5x over 30 requests."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "VmRSS delta over 120 weather requests (Pura 70 Ultra)",
      "unfixed": [
        56884,
        56972,
        57440
      ],
      "fixed": [
        38644,
        37880,
        38512
      ],
      "note": "+57.0MB vs +38.5MB VmRSS growth over the same 120-request workload (~18MB = 120 retained response bodies; disjoint ranges, 1.48x). fd counts are flat in both variants because sessions pool sockets, so the oracle is retained bytes (measurements-staging-v2)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py weatherassistant_http_session_leak",
    "python3 tools/sign_clean_cases.py weatherassistant_http_session_leak",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/weatherassistant_http_session_leak/testcase/ into perf_testing/hapray/testcases/com.alatus.futureweather/.",
    "Install each clean signed variant and run the MemLoad_weatherassistant_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
