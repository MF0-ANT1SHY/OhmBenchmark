  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "response_handler_cpu_ms",
      "definition": "CPU time inside the OHMB/response_logging hiTraceMeter region per API call (the success-path logging statement), averaged over 100 calls per run.",
      "comparison": "unfixed serializes each full response body (O(payload)); fixed logs O(1) fields. Measured: unfixed 1.00ms/call vs fixed 0.22ms/call (4.5x, n=300 each; per-run sums ~104ms vs ~25ms)."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over 100 fixture requests (Pura 70 Ultra)",
      "unfixed": [
        315292103,
        328791181,
        323866609
      ],
      "fixed": [
        266184074,
        266943452,
        274443107
      ],
      "note": "324M vs 267M median instructions (1.21x, disjoint ranges) over a 100-request run against device-tests/response_server.py (~55KB flat body, HTTP/1.1 keep-alive). The fixture shape is deliberate: expectDataType:OBJECT stops parsing bodies above ~64KB, and a many-small-rows body inflates the shared parse baseline enough to hide the logging-path delta. The unfixed handler serialized 100 full bodies vs 0 on fixed (ohmResponseStringify counter)."
    }
  },
