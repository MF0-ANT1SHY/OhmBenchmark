  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "sidebar_count_queries_per_refresh",
      "definition": "Number of RDB SELECT statements attributable to unread-count computation per sidebar refresh, and total refresh latency.",
      "comparison": "unfixed: N queries per refresh (one per feed); fixed: 1. With 15+ feeds, sidebar refresh latency after article-open drops accordingly."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
