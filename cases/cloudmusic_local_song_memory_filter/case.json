  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "elapsed_ms",
      "definition": "Wall time of the case action, measured in the app.",
      "comparison": "unfixed scans all rows in memory (CPU grows with library size); fixed returns only matching rows from SQLite. With >= 300 local songs, unfixed_avg_ms > fixed_avg_ms."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions",
      "unfixed": [
        96834558,
        91354916,
        154449077
      ],
      "fixed": [
        30644715,
        26854860,
        102776450
      ],
      "note": "96.8M vs 30.6M instructions (3.2x) even at the small 10-song fixture; the gap grows with library size"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py cloudmusic_local_song_memory_filter",
    "python3 tools/sign_clean_cases.py cloudmusic_local_song_memory_filter",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/cloudmusic_local_song_memory_filter/testcase/ into perf_testing/hapray/testcases/cc.chenlvin.cloudmusic/.",
    "Install each clean signed variant and run the PerfLoad_cloudmusic_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
