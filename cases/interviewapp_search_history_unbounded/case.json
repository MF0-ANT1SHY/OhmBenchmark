  "android_source_case": "dns66_packet_cache_growth",
  "android_mechanism": "Cache/data structure grows without bound; fix bounds the retained data",
  "category": "resource_retention",
  "bug_description": "The search-history store persists every keyword as its own preference key and never bounds the number of entries. The history grows without limit, the history component renders an ever-growing ForEach, and preferences storage/flush volume grows with every search.",
  "perf_scenarios": [
    "状态更新",
    "页面切换"
  ],
  "unfixed_commit": "4fd37562f8060ce572f580d89dbf9d3a33052e63",
  "fixed_commit": "9f226e3d8793bf1a9396221d5c518debd7b8bde5",
  "fix_summary": "History is kept as a single ordered JSON list capped at the 20 most recent keywords.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "MemLoad_interviewapp_0030",
    "py_file": "testcase/MemLoad_interviewapp_0030.py",
    "descriptor": "testcase/MemLoad_interviewapp_0030.json",
    "install_dir": "perf_testing/hapray/testcases/com.itcast.pass_interview",
    "driver": "DeviceTest",
    "module": "phone",
    "ability": "PhoneAbility",
    "trigger": "external_ui",
    "workload": "testcase/MemLoad_interviewapp_0030.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf",
      "memory"
    ],
    "step_duration_s": 20,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "app_pss_bytes",
    "definition": "Pss of the app process after the workload, from the periodic smaps_rollup snapshots in memory/.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "history_entries_and_render_cost",
      "definition": "Number of history entries retained after 60 searches, size of the preferences file, and CPU/time to render the history component when the search page opens.",
      "comparison": "unfixed retains 60+ entries and growing render/storage cost; fixed retains 20. unfixed history-component build cost and preferences size > fixed."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "VmRSS delta (kB) over the seeded-history read path",
      "unfixed": [
        22496,
        22040,
        20964
      ],
      "fixed": [
        -608,
        -1008,
        -1116
      ],
      "note": "+22.0MB vs -1.0MB VmRSS growth (unfixed retains all 500000 seeded entries; fixed caps at 2000). hw-instructions in the same runs: 2.33G vs 32M (73x); bench result 500000 vs 2000 entries. Measured on Pura 70 Ultra (measurements-staging/interviewapp_search_history_unbounded)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py interviewapp_search_history_unbounded",
    "python3 tools/sign_clean_cases.py interviewapp_search_history_unbounded",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/interviewapp_search_history_unbounded/testcase/ into perf_testing/hapray/testcases/com.itcast.pass_interview/.",
    "Install each clean signed variant and run the MemLoad_interviewapp_0030 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
