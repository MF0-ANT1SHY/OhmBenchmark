    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "app_pss_bytes",
    "definition": "Final absolute app-process PSS after opening the normal history page and a fixed three-second settling period. Kernel smaps_rollup samples bracket the entire page-opening workload. Every trial uses a freshly restored production state derived from the same 2,500 search submissions.",
    "comparison": "unfixed >= 1.3 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean",
      "metric": "app_pss_bytes",
      "unfixed": [
        364454912,
        358107136,
        365289472
      ],
      "fixed": [
        77057024,
        77926400,
        76762112
      ],
      "median_ratio": 4.729678010923443,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Every paired round and the median meet 1.3x."
    },
    "mechanism_oracle": {
      "metric": "native_retained_history_entries",
      "definition": "After each PSS window, verify the visible history page and parse the actual native historyStore XML. Compare its complete contents with the production state derived from the same 2,500 submissions.",
      "comparison": "Unfixed retains all 2,500 unique keywords; fixed retains the latest 20. Both variants show prepared history entries in the normal page. All three process-PSS pairs and their median must be >=1.3x. No separate history-component CPU-time claim is made."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "VmRSS delta (kB) over the seeded-history read path",
      "unfixed": [
        22496,
        22040,
        20964
      ],
      "fixed": [
        -608,
        -1008,
        -1116
      ],
      "note": "+22.0MB vs -1.0MB VmRSS growth (unfixed retains all 500000 seeded entries; fixed caps at 2000). hw-instructions in the same runs: 2.33G vs 32M (73x); bench result 500000 vs 2000 entries. Measured on Pura 70 Ultra (measurements-staging/interviewapp_search_history_unbounded)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py interviewapp_search_history_unbounded",
    "python3 tools/sign_clean_cases.py interviewapp_search_history_unbounded",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/interviewapp_search_history_unbounded/testcase/ into perf_testing/hapray/testcases/com.itcast.pass_interview/.",
    "Install each clean signed variant and run the MemLoad_interviewapp_0030 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
