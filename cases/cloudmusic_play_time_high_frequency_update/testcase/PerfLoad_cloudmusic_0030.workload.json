{
  "bundle": "cc.chenlvin.cloudmusic",
  "ability": "EntryAbility",
  "description": "通过普通本地曲库菜单播放真实60秒音频，在完整播放器观察播放进度推进",
  "setup": [
    {
      "op": "wait",
      "selector": {
        "text": "发现",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "tap",
      "selector": {
        "text": "本地曲库",
        "match": "exact"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "共 10000 首歌曲",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "tap",
      "selector": {
        "text": "Track 9999",
        "match": "exact",
        "type": "Text"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "播放",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "tap",
      "selector": {
        "text": "播放",
        "match": "exact"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "Track 9999",
        "match": "exact",
        "type": "Text",
        "index": 1
      },
      "timeout_s": 60
    },
    {
      "op": "tap",
      "selector": {
        "text": "Track 9999",
        "match": "exact",
        "type": "Text",
        "index": 1
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "本地文件播放中",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "wait",
      "selector": {
        "type": "Slider"
      },
      "timeout_s": 60
    }
  ],
  "measured": [
    {
      "op": "pause",
      "seconds": 20
    }
  ],
  "verify": [
    {
      "op": "wait",
      "selector": {
        "text": "本地文件播放中",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "wait",
      "selector": {
        "type": "Slider"
      }
    }
  ]
}
