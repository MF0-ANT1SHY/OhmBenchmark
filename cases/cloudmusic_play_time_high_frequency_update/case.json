  "android_source_case": "fdroid_method_04298f8886b2",
  "android_mechanism": "Progress broadcast emitted on every update; fix emits only when the value actually changes",
  "category": "cpu",
  "bug_description": "AVPlayerUtils' timeUpdate callback writes the millisecond-precision playback position into the global PLAY_TIME AppStorage state on every callback (about 10 times per second). The full player page binds PLAY_TIME via @StorageProp, so the heavy player view (cover art, controls, lyrics entry) re-renders at callback frequency even though the displayed progress only changes once per second, wasting UI-thread CPU during playback and draining battery.",
  "perf_scenarios": [
    "动画",
    "状态更新"
  ],
  "unfixed_commit": "2aa471589e637964e0ef9ba37c0ef9e9db5b6de7",
  "fixed_commit": "d755085f20e4ba7bddffce1e6ee8e06b1e0b1966",
  "fix_summary": "The global state is written only when the whole-second part of the position changes (seek still updates immediately).",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_cloudmusic_0030",
    "py_file": "testcase/PerfLoad_cloudmusic_0030.py",
    "descriptor": "testcase/PerfLoad_cloudmusic_0030.json",
    "install_dir": "perf_testing/hapray/testcases/cc.chenlvin.cloudmusic",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_cloudmusic_0030.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 70,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "player_page_rerenders_per_minute",
      "definition": "Count of player-page state-update/render passes attributable to PLAY_TIME changes during 60s of idle playback (ace trace component update events or JS state-set calls), plus UI-thread CPU time.",
      "comparison": "unfixed ~600 state writes/minute (10/s); fixed ~60/minute (1/s). unfixed UI CPU time > fixed by a clearly measurable margin during playback."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the playback progress-update window (Pura 70 Ultra)",
      "unfixed": [
        7871713,
        8337462,
        7906151
      ],
      "fixed": [
        3883766,
        3363295,
        4369473
      ],
      "note": "7.91M vs 3.88M median hw-instructions (2.04x, disjoint ranges); mechanism counter 600 vs 60 PLAY_TIME state writes per minute (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py cloudmusic_play_time_high_frequency_update",
    "python3 tools/sign_clean_cases.py cloudmusic_play_time_high_frequency_update",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/cloudmusic_play_time_high_frequency_update/testcase/ into perf_testing/hapray/testcases/cc.chenlvin.cloudmusic/.",
    "Install each clean signed variant and run the PerfLoad_cloudmusic_0030 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
