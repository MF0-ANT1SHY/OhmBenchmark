  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "player_page_updates_per_minute",
      "definition": "Count of page state updates / render passes attributable to currentValue during 60s idle playback, plus UI-thread CPU time.",
      "comparison": "unfixed ~600 updates/minute vs fixed ~60/minute; unfixed UI CPU during playback > fixed."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "page updates/minute",
      "unfixed": [
        600,
        600,
        600
      ],
      "fixed": [
        60,
        60,
        60
      ],
      "note": "600 vs 60 state updates per minute (mechanism counter, authoritative); whole-step hw-instruction medians sit inside the noise band (5.0M vs 5.5M), so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py ytmusic_current_playing_timeupdate",
    "python3 tools/sign_clean_cases.py ytmusic_current_playing_timeupdate",
