{
  "id": "cloudmusic_indexof_in_render",
  "host_app": {
    "name": "CloudMusic-HarmonyOSNext (仿网易云音乐)",
    "repository": "https://github.com/Chenlvin/CloudMusic-HarmonyOSNext",
