  "android_source_case": "fdroid_category_id_cache",
  "android_mechanism": "Repeated lookup executed per row during import; fix caches the lookup",
  "category": "cpu",
  "bug_description": "In the playlist page content list, every song row build passes sid/index to SongCard as this.list.indexOf(item), twice per row. indexOf is a linear scan over the whole (potentially 1000+) song list, so rendering/scrolling the playlist costs O(n) per row and O(n^2) cumulative, wasting UI-thread time as the list grows.",
  "perf_scenarios": [
    "列表滑动",
    "网络结果渲染"
  ],
  "unfixed_commit": "f8fd90d72af8c72f05d54823792b45c0474c923d",
  "fixed_commit": "a967ef10ae9722d19100d6dfbf00760467397a3c",
  "fix_summary": "The index already provided by the LazyForEach item generator is passed to SongCard, removing both per-row linear scans.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_cloudmusic_0010",
    "py_file": "testcase/PerfLoad_cloudmusic_0010.py",
    "descriptor": "testcase/PerfLoad_cloudmusic_0010.json",
    "install_dir": "perf_testing/hapray/testcases/cc.chenlvin.cloudmusic",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_cloudmusic_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 25,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "row_build_cpu_overhead",
      "definition": "UI-thread CPU time attributable to list-row building during the scroll (from ace trace component-build events), divided by number of rows rendered.",
      "comparison": "unfixed per-row build time grows linearly with playlist size (indexOf scan) while fixed stays constant; with >= 500 songs, unfixed scroll CPU > fixed by >= 10% and unfixed shows more dropped frames."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the search-result render workload (Pura 70 Ultra)",
      "unfixed": [
        6457682,
        6640043,
        4220519
      ],
      "fixed": [
        4014264,
        2649980,
        2746105
      ],
      "note": "6.46M vs 2.75M median hw-instructions (2.35x, disjoint ranges); mechanism counter 250500 vs 0 indexOf comparisons per render pass (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py cloudmusic_indexof_in_render",
    "python3 tools/sign_clean_cases.py cloudmusic_indexof_in_render",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/cloudmusic_indexof_in_render/testcase/ into perf_testing/hapray/testcases/cc.chenlvin.cloudmusic/.",
    "Install each clean signed variant and run the PerfLoad_cloudmusic_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
