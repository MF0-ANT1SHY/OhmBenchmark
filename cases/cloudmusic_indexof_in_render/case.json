      "median_ratio": 1.0070444542137138,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Clean captures are valid, but the required 1.2x performance improvement is not met; this case is not accepted."
    },
    "mechanism_oracle": {
      "metric": "row_build_cpu_overhead",
      "definition": "UI-thread CPU time attributable to list-row building during the scroll (from ace trace component-build events), divided by number of rows rendered.",
      "comparison": "unfixed per-row build time grows linearly with playlist size (indexOf scan) while fixed stays constant; with >= 500 songs, unfixed scroll CPU > fixed by >= 10% and unfixed shows more dropped frames."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the search-result render workload (Pura 70 Ultra)",
      "unfixed": [
        6457682,
