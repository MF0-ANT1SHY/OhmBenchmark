{
  "bundle": "cc.chenlvin.cloudmusic",
  "ability": "EntryAbility",
  "description": "打开歌单并浏览歌曲列表",
  "setup": [
    {
      "op": "wait",
      "selector": {
        "text": "音乐云盘",
        "match": "exact"
      }
    },
    {
      "op": "tap",
      "selector": {
        "hint": "搜索内容"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "搜索",
        "match": "exact"
      }
    },
    {
      "op": "input",
      "selector": {
        "type": "SearchField",
        "hint": "搜索内容"
      },
      "value": "music"
    },
    {
      "op": "key",
      "key": 2054
    },
    {
      "op": "wait",
      "selector": {
        "text": "单曲",
        "match": "exact"
      }
    },
    {
      "op": "tap",
      "selector": {
        "text": "歌单",
        "match": "exact"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "Collection",
        "match": "exact"
      }
    }
  ],
  "measured": [
    {
      "op": "tap",
      "selector": {
        "text": "Collection",
        "match": "exact"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "Track 1",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "swipe",
      "count": 5
    }
  ],
  "verify": [
    {
      "op": "wait",
      "selector": {
        "text": "Track [1-9][0-9]*",
        "match": "regex"
      }
    },
    {
      "op": "wait",
      "selector": {
        "text": "Artist 1, Artist 2, Artist 3, Artist 4, Artist 5, Artist 6, Artist 7, Artist 8, Artist 9, Artist 10, Artist 11, Artist 12",
        "match": "exact"
      }
    }
  ]
}
