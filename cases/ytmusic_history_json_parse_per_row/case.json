  "android_source_case": "fdroid_precomputed_preferred_metadata",
  "android_mechanism": "Per-row metadata recomputed on every access; fix computes it once",
  "category": "cpu",
  "bug_description": "The listening-history page stores each entry as a JSON string and calls JSON.parse(item) four times per row inside the build (cover image URL, name, creator, and click params). Every render of the history list re-parses every entry's JSON four times, wasting UI-thread CPU and growing linearly with history length (plus re-parses on every list mutation).",
  "perf_scenarios": [
    "列表滑动",
    "状态更新",
    "组件创建"
  ],
  "unfixed_commit": "5bf6142f76af3ff2fd25b6f731a27fee6b838346",
  "fixed_commit": "1e3d086fee748d99ffcdd31d18b4f793ddab8491",
  "fix_summary": "The item list is mapped to parsed objects once per render and rows read the parsed fields; deletion re-serializes only the affected entry.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_ytmusic_0020",
    "py_file": "testcase/PerfLoad_ytmusic_0020.py",
    "descriptor": "testcase/PerfLoad_ytmusic_0020.json",
    "install_dir": "perf_testing/hapray/testcases/com.example.myapplication",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_ytmusic_0020.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 15,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "history_page_render_cpu_ms",
      "definition": "UI-thread CPU time from page-show to last row rendered plus the re-render after one deletion, from the ace trace.",
      "comparison": "unfixed performs 4*history_size JSON.parse calls per render (visible in JS sampling); fixed performs history_size parses. unfixed_render_cpu_ms > fixed by >= 25% with 30+ entries."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "JSON.parse calls per render",
      "unfixed": [
        600,
        600,
        600
      ],
      "fixed": [
        200,
        200,
        200
      ],
      "note": "600 vs 200 JSON.parse calls per history-page render (mechanism counter, authoritative); whole-step hw-instruction medians are flat (714M vs 695M) because fixed still parses a large baseline, so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py ytmusic_history_json_parse_per_row",
    "python3 tools/sign_clean_cases.py ytmusic_history_json_parse_per_row",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/ytmusic_history_json_parse_per_row/testcase/ into perf_testing/hapray/testcases/com.example.myapplication/.",
    "Install each clean signed variant and run the PerfLoad_ytmusic_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
