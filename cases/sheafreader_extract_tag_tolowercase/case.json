    },
    "mechanism_oracle": {
      "metric": "trace_cpu_ms",
      "definition": "CPU time across the refresh case window, from trace.",
      "comparison": "unfixed performs one full-fragment toLowerCase copy per extracted tag (~6 per item); fixed none. unfixed parse CPU and GC activity > fixed by >= 15% on feeds with long descriptions."
    },
