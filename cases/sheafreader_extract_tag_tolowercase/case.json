{
  "id": "sheafreader_extract_tag_tolowercase",
  "host_app": {
    "name": "Sheaf-Reader (束阅 RSS 阅读器)",
    "repository": "https://github.com/simon2137/Sheaf-Reader",
    "bundle_name": "com.sheafreader.hm",
    "local_path": "hosts/sheafreader",
    "base_branch": "ohmbase",
    "base_commit": "e04ef65"
  },
  "android_source_case": "fdroid_sax_character_allocation",
  "android_mechanism": "The complete SAX character buffer is copied on every text event; fix avoids the per-event copy",
  "category": "cpu",
  "bug_description": "FeedParser.extractTag locates the closing tag with xml.toLowerCase().indexOf(...), materializing a full lowercase copy of the item fragment for every extracted tag. Parsing one RSS item extracts ~6 tags (title/link/description/date/guid/author), so each refresh of a feed with N items allocates and scans ~6N full-fragment lowercase copies on the parsing thread, increasing GC pressure and feed-refresh latency.",
  "perf_scenarios": [
    "数据库读取",
    "网络结果渲染"
  ],
  "unfixed_commit": "79cacfd4cbb6bbeb9edaa96ff88c209902a94ab1",
  "fixed_commit": "d6e095d1bec0d60dc7848e222e4be01f264b1a60",
  "fix_summary": "Use native tag-prefix and CDATA-marker searches, folding only bounded tag names; avoid full-fragment lowercase copies and whole-body regexp scans while retaining case-insensitive extraction.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_sheafreader_0020",
    "py_file": "testcase/PerfLoad_sheafreader_0020.py",
    "descriptor": "testcase/PerfLoad_sheafreader_0020.json",
    "install_dir": "perf_testing/hapray/testcases/com.sheafreader.hm",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_sheafreader_0020.workload.json"
  },
