{
  "id": "sheafreader_extract_tag_tolowercase",
  "host_app": {
    "name": "Sheaf-Reader (束阅 RSS 阅读器)",
    "repository": "https://github.com/simon2137/Sheaf-Reader",
    "bundle_name": "com.sheafreader.hm",
    "local_path": "hosts/sheafreader",
    "base_branch": "ohmbase",
    "base_commit": "e04ef65"
  },
  "android_source_case": "fdroid_sax_character_allocation",
  "android_mechanism": "The complete SAX character buffer is copied on every text event; fix avoids the per-event copy",
  "category": "cpu",
  "bug_description": "FeedParser.extractTag locates the closing tag with xml.toLowerCase().indexOf(...), materializing a full lowercase copy of the item fragment for every extracted tag. Parsing one RSS item extracts ~6 tags (title/link/description/date/guid/author), so each refresh of a feed with N items allocates and scans ~6N full-fragment lowercase copies on the parsing thread, increasing GC pressure and feed-refresh latency.",
  "perf_scenarios": [
    "数据库读取",
    "网络结果渲染"
  ],
  "unfixed_commit": "e04ef65673a7b3a0da2de85fb7b954663232dec7",
  "fixed_commit": "f62858e1ca337cbc1d128cec51917d792c3f4c68",
  "fix_summary": "The closing tag is located with a case-insensitive regex over the remaining substring, eliminating the per-tag lowercase copy while preserving case-insensitive matching semantics.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_sheafreader_0020",
    "py_file": "testcase/PerfLoad_sheafreader_0020.py",
    "descriptor": "testcase/PerfLoad_sheafreader_0020.json",
    "install_dir": "perf_testing/hapray/testcases/com.sheafreader.hm",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_sheafreader_0020.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 40,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "trace_cpu_ms",
      "definition": "CPU time across the refresh case window, from trace.",
      "comparison": "unfixed performs one full-fragment toLowerCase copy per extracted tag (~6 per item); fixed none. unfixed parse CPU and GC activity > fixed by >= 15% on feeds with long descriptions."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        25878521817,
        25796251259,
        25931635945
      ],
      "fixed": [
        11205986526,
        11169483753,
        11224455511
      ],
      "note": "25.9G vs 11.2G instructions (2.3x); cpu 3089 vs 1508 ms"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py sheafreader_extract_tag_tolowercase",
    "python3 tools/sign_clean_cases.py sheafreader_extract_tag_tolowercase",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/sheafreader_extract_tag_tolowercase/testcase/ into perf_testing/hapray/testcases/com.sheafreader.hm/.",
    "Install each clean signed variant and run the PerfLoad_sheafreader_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
