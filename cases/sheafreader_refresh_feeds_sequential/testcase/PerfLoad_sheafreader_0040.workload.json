{
  "bundle": "com.sheafreader.hm",
  "ability": "EntryAbility",
  "description": "Open the reader and wait for its automatic subscription refresh",
  "setup": [
    {
      "op": "stop"
    }
  ],
  "measured": [
    {
      "op": "launch"
    },
    {
      "op": "pause",
      "seconds": 1
    },
    {
      "op": "wait",
      "selector": {
        "type": "Button",
        "bounds": "[195,326][296,427]",
        "enabled": "true",
        "match": "exact"
      },
      "timeout_s": 90
    }
  ],
  "verify": [
    {
      "op": "wait",
      "selector": {
        "text": "Journal 1 article 1",
        "match": "exact"
      },
      "timeout_s": 60
    }
  ]
}
