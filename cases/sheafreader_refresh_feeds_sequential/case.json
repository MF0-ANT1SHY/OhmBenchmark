  "test_oracle": {
    "metric": "startup_refresh_elapsed_s",
    "definition": "Elapsed normal startup including all-feed refresh under identical 1.5-second RSS response latency. Every unfixed lower timing bound must exceed 1.5 times its paired fixed upper bound; native CPU is diagnostic only.",
    "comparison": "unfixed conservative lower bound >= 1.5 * fixed upper bound over 3 paired rounds",
    "evidence": {
      "status": "measured_clean",
      "metric": "startup_refresh_elapsed_s",
      "unfixed": [
        21.25579310000103,
        21.574176899999657,
        21.187260400000014
      ],
      "fixed": [
        9.72918910000044,
        9.796314799999891,
        9.960387299999638
      ],
      "paired_conservative_ratios": [
        1.8567428193989528,
        1.8735227455124577,
        1.7951272436965613
      ],
      "median_ratio": 1.844020161540805,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Complete app startup and all-feed refresh; conservative timing bounds under declared 1.5-second RSS response latency. Native CPU data is diagnostic, not an improvement claim."
    },
    "mechanism_oracle": {
      "metric": "complete_native_feed_refresh",
      "definition": "All ten existing subscription timestamps advance; complete 1,000-article contents remain identical; ordinary refresh UI completes. Source regression checks preserve concurrent inserted totals, four-worker bound, scoped and scheduled refresh. No app counters.",
      "comparison": "Three complete pairs with identical input and service identity."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "trace_cpu_ms",
      "unfixed": [
        5420,
        5515,
        5039
      ],
      "fixed": [
        3930,
        4112,
        3812
      ],
      "note": "cpu 5420 vs 3930 ms (+38%, disjoint ranges); total instructions match because the same fetches run, so the oracle is sched CPU time"
    }
  },
