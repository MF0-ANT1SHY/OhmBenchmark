  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "Sampled retired-instruction period sum (hw-instructions) attributed to the app process in the complete externally driven measured window.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean",
      "metric": "hiperf_instructions",
      "unfixed": [
        12212669871,
        12238308976,
        11967515145
      ],
      "fixed": [
        5099750308,
        5047644852,
        5041658899
      ],
      "median_ratio": 2.4194788320261957,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Every paired round exceeds 1.2x; app process explicitly selected from the system report."
    },
    "mechanism_oracle": {
      "metric": "article_row_build_count",
      "definition": "Count of article card component builds during open + load-more + scroll (ace trace), first-render latency after open, and dropped frames while scrolling.",
      "comparison": "unfixed builds every accumulated article (hundreds) eagerly; fixed builds only viewport rows. unfixed first-render and scroll jank measurably worse."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / sw-task-clock / VmRSS delta",
      "unfixed": [
        4871567917,
        4842343144,
        4883882521
      ],
      "fixed": [
        381802167,
        338417365,
        344065090
      ],
      "note": "4.87G vs 344M instructions (14.2x); task clock 1569 vs 281 ms (5.6x); VmRSS +340MB vs +6MB (53x). Measured on Pura 70 Ultra, 600-article feed, 3 runs each (measurements-staging/sheafreader_article_list_foreach)."
    }
  },
