    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "mainpage_build_ms",
      "definition": "Time from MainPage creation (first build event in ace trace) to first frame rendered, averaged over recreations.",
      "comparison": "unfixed shows TTF file reads + font registration work in the page-build path on every creation; fixed only on the first. unfixed_avg_build_ms > fixed_avg_build_ms (fixed approaches the no-font-work floor)."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "font registrations per MainPage creation",
      "unfixed": [
        2.0
      ],
      "fixed": [
        0.1
      ],
      "note": "2.0 vs 0.1 font registrations per MainPage creation (mechanism counter, authoritative); whole-step hw-instruction medians are flat (59M vs 60M) because the window is dominated by page build, so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
