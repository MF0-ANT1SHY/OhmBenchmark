  "android_source_case": "calculator_themed_font_lookup",
  "android_mechanism": "Themed-font handling repeated expensive font work; fix performs the lookup/registration once",
  "category": "latency",
  "bug_description": "MainPage.aboutToAppear unconditionally calls font.registerFont for two custom font families (iconfont.ttf and DINCOROS-Regular.ttf) every time the main page component is created. Each registration re-loads and re-parses the TTF files; navigating back to the main page (router.replaceUrl flows) repeats the work and delays page build, growing memory with duplicate typeface entries.",
  "perf_scenarios": [
    "页面启动",
    "页面切换"
  ],
  "unfixed_commit": "30cc357936f8fff776d9c0e6b7e6f4b29668367b",
  "fixed_commit": "e720e2150a6a062c85ccbe8269399d4edc6e7300",
  "fix_summary": "Font registration is guarded by a once-per-process static flag so the TTFs are loaded only on first creation.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_sepweather_0010",
    "py_file": "testcase/PerfLoad_sepweather_0010.py",
    "descriptor": "testcase/PerfLoad_sepweather_0010.json",
    "install_dir": "perf_testing/hapray/testcases/cn.seayj.sepweather",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_sepweather_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 30,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "mainpage_build_ms",
      "definition": "Time from MainPage creation (first build event in ace trace) to first frame rendered, averaged over recreations.",
      "comparison": "unfixed shows TTF file reads + font registration work in the page-build path on every creation; fixed only on the first. unfixed_avg_build_ms > fixed_avg_build_ms (fixed approaches the no-font-work floor)."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "font registrations per MainPage creation",
      "unfixed": [
        2.0
      ],
      "fixed": [
        0.1
      ],
      "note": "2.0 vs 0.1 font registrations per MainPage creation (mechanism counter, authoritative); whole-step hw-instruction medians are flat (59M vs 60M) because the window is dominated by page build, so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py sepweather_font_register_per_page",
    "python3 tools/sign_clean_cases.py sepweather_font_register_per_page",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/sepweather_font_register_per_page/testcase/ into perf_testing/hapray/testcases/cn.seayj.sepweather/.",
    "Install each clean signed variant and run the PerfLoad_sepweather_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
