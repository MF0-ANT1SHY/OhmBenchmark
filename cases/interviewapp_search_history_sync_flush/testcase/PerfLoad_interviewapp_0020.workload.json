{
  "bundle": "com.itcast.pass_interview",
  "ability": "PhoneAbility",
  "description": "interview-handbook-project (面试通)页面操作",
  "setup": [
    {
      "op": "wait",
      "selector": {
        "text": "热门题库"
      }
    },
    {
      "op": "tap",
      "selector": {
        "text": "搜索题目",
        "match": "exact"
      }
    },
    {
      "op": "if_present",
      "selector": {
        "text": "立即登录",
        "match": "exact"
      },
      "actions": [
        {
          "op": "tap",
          "selector": {
            "type": "Checkbox",
            "match": "exact"
          }
        },
        {
          "op": "tap",
          "selector": {
            "text": "立即登录",
            "match": "exact"
          }
        }
      ]
    },
    {
      "op": "wait",
      "selector": {
        "hint": "请输入关键词",
        "match": "exact"
      },
      "timeout_s": 30
    }
  ],
  "measured": [
    {
      "op": "submit_queries",
      "selector": {
        "hint": "请输入关键词",
        "match": "exact"
      },
      "values": [
        "question0",
        "question1",
        "question2",
        "question3",
        "question4",
        "question5",
        "question6",
        "question7",
        "question8",
        "question9",
        "question10",
        "question11",
        "question12",
        "question13",
        "question14",
        "question15",
        "question16",
        "question17",
        "question18",
        "question19"
      ],
      "interval_ms": 25,
      "between_submits_ms": 150
    },
    {
      "op": "pause",
      "seconds": 2.5
    }
  ],
  "verify": [
    {
      "op": "wait",
      "selector": {
        "hint": "请输入关键词",
        "text": "question19",
        "match": "exact"
      }
    }
  ]
}
