  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "flush_count_per_search_burst",
      "definition": "Number of preference flush (fsync/disk write) operations attributable to the history store during a 10-search burst, and their total wall/CPU time from the disk trace.",
      "comparison": "unfixed: 10 flushes (one per search) on the calling thread; fixed: 1 flush after the burst. unfixed disk-sync time on the search path > fixed by >= 5x for the burst."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        3288553707,
        3090556140,
        3384493157
      ],
      "fixed": [
        165929778,
        165402478,
        171054649
      ],
      "note": "3.29G vs 166M instructions (20x); cpu 6867 vs 328 ms; 1000 vs 1 flushes"
    }
  },
