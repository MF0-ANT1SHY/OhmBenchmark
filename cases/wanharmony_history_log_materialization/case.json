  },
  "android_source_case": "lightning_history_materialization",
  "android_mechanism": "Suggestions materialize all matching history rows instead of a bounded recent subset",
  "category": "cpu",
  "bug_description": "WebPage.onTitleReceive serializes the ENTIRE browsing-history list with JSON.stringify(list.map(...)) twice (before and after every recorded page visit), and HistoryPage.aboutToAppear stringifies the whole list again when the history page opens. With a large history this materializes and stringifies hundreds of entries on every page-load title event, blocking the web page load path and the history page transition.",
  "perf_scenarios": [
    "网络结果渲染",
    "页面切换"
  ],
  "unfixed_commit": "85a73986cd4eee9c04cdbffc96aefc947e1f3bab",
  "fixed_commit": "87d63ec508b1d6ee950f9e5f55c0146bc189b233",
  "fix_summary": "The debug logs report the list size only, removing full-list map + JSON.stringify on the page-load and page-open paths.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_wanharmony_0010",
    "py_file": "testcase/PerfLoad_wanharmony_0010.py",
    "descriptor": "testcase/PerfLoad_wanharmony_0010.json",
    "install_dir": "perf_testing/hapray/testcases/org.example.wan.ohos",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_wanharmony_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 180,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "trace_cpu_ms",
    "definition": "on-CPU time of the app process during the measured step, from the sched events in trace.htrace.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "trace_cpu_ms",
      "definition": "CPU time of the app process across the case window, from trace.",
      "comparison": "unfixed spends O(history_size) in JSON serialization per open (grows with history); fixed is O(1). With 100+ entries unfixed > fixed by >= 30% on the title-event path."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "trace_cpu_ms over the lifecycle-log phase",
      "unfixed": [
        49.9,
        7.4,
        8.3
      ],
      "fixed": [
        0.1,
        0.1,
        0.1
      ],
      "note": "phase-scoped cpu 49.9 vs 0.1 ms; whole-window instructions do not discriminate (page-open work dominates), so the oracle is the title-event phase CPU"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py wanharmony_history_log_materialization",
    "python3 tools/sign_clean_cases.py wanharmony_history_log_materialization",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/wanharmony_history_log_materialization/testcase/ into perf_testing/hapray/testcases/org.example.wan.ohos/.",
    "Install each clean signed variant and run the PerfLoad_wanharmony_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
