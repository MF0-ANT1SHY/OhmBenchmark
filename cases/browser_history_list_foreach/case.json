  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "Sampled retired-instruction period sum (hw-instructions) attributed to the app process in the complete externally driven measured window.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean",
      "metric": "hiperf_instructions",
      "unfixed": [
        10968865584,
        10978280673,
        10936138517
      ],
      "fixed": [
        4040506851,
        4035677834,
        4048744455
      ],
      "median_ratio": 2.7147251541685358,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Every paired round exceeds 1.2x; app process explicitly selected from the system report."
    },
    "mechanism_oracle": {
      "metric": "component_build_count_and_first_frame_ms",
      "definition": "(a) Time from dialog-open event to first rendered history frame; (b) count of HistoryItem component build/attach operations in the ace trace during the whole scroll; (c) dropped-frame count while scrolling.",
      "comparison": "unfixed builds all N components at open (N = seeded entries) vs fixed builds only visible rows (~10-15); unfixed_first_frame_ms > fixed_first_frame_ms; unfixed shows more jank frames during scroll."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        9637608919,
        9630561356,
        9725313176
      ],
      "fixed": [
        2789693645,
        2751031972,
        2799537880
      ],
      "note": "9.64G vs 2.79G instructions (3.5x); cpu 5986 vs 4041 ms; builds 200 vs 59"
    }
  },
