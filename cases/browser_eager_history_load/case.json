{
  "id": "browser_eager_history_load",
  "host_app": {
    "name": "browser (小狐狸浏览器)",
    "repository": "https://github.com/langwudong/browser",
    "bundle_name": "com.example.nanvision",
    "local_path": "hosts/browser",
    "base_branch": "ohmbase",
    "base_commit": "c42e4b3",
    "upstream_base_commit": "f44fff7"
  },
  "android_source_case": "lightning_history_materialization",
  "android_mechanism": "Browser search suggestions materialize all matching history rows eagerly",
  "category": "latency",
  "bug_description": "On application startup the main page eagerly queries every per-day history table in the RDB database and materializes all browsing-history rows in memory (Index.aboutToAppear -> RdbUtils.queryAllDate + queryHistoriesByDate for each date), even though history is only consumed when the user opens the browsing-history dialog. Cold-start latency and startup CPU grow linearly with the number of recorded history entries.",
  "perf_scenarios": [
    "页面启动",
    "数据库读取"
  ],
  "unfixed_commit": "c42e4b34960aa3de5f6f34b83c60a3b2024e70bb",
  "fixed_commit": "e3c8aa99fd6a93333a9e906216545861aec07456",
  "fix_summary": "History is loaded lazily on first open of the history dialog (PagesDialog.loadHistoryData), and RdbUtils.queryHistoriesByDate now actually awaits the RDB query instead of returning an unfilled array.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_browser_0010",
    "py_file": "testcase/PerfLoad_browser_0010.py",
    "descriptor": "testcase/PerfLoad_browser_0010.json",
    "install_dir": "perf_testing/hapray/testcases/com.example.nanvision",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_browser_0010.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 15,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "Sampled retired-instruction period sum (hw-instructions) attributed to the app process in the complete externally driven measured window.",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "measured_clean",
      "metric": "hiperf_instructions",
      "unfixed": [
        1777740431,
        1756342612,
        1805539155
      ],
      "fixed": [
        1313976611,
        1285360539,
        1308952979
      ],
      "median_ratio": 1.3581392605547522,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Every paired round exceeds 1.2x; app process explicitly selected from the system report."
    },
    "mechanism_oracle": {
      "metric": "trace_cpu_ms",
      "definition": "CPU time of the app process across the case window, from trace.",
      "comparison": "unfixed_startup_cpu_time_ms > fixed_startup_cpu_time_ms by >= 20% with 30+ seeded history entries; fixed shows zero history-table SELECT queries during startup, unfixed shows N (one per day table).",
      "auxiliary": "hilog marker '项目已启动' timestamp delta from process start."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions / trace_cpu_ms",
      "unfixed": [
        4862521465,
        4717430103,
        5046213668
      ],
      "fixed": [
        1511572583,
        1345359423,
        1530821367
      ],
      "note": "startup window: 4.86G vs 1.51G instructions (3.2x); cpu 2122 vs 747 ms"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py browser_eager_history_load",
    "python3 tools/sign_clean_cases.py browser_eager_history_load",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/browser_eager_history_load/testcase/ into perf_testing/hapray/testcases/com.example.nanvision/.",
    "Install each clean signed variant and run the PerfLoad_browser_0010 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
