  "android_source_case": "listmyapps_view_recycling",
  "android_mechanism": "List rows eagerly created / not recycled while scrolling",
  "category": "latency",
  "bug_description": "The song search-result tab renders results with a plain ForEach inside List. Loading several result pages (30 per page) eagerly creates SongCard components for every accumulated result — including off-screen ones — and rebuilds them as the array grows, slowing search-result display and scrolling.",
  "perf_scenarios": [
    "列表滑动",
    "网络结果渲染",
    "组件创建"
  ],
  "unfixed_commit": "d755085f20e4ba7bddffce1e6ee8e06b1e0b1966",
  "fixed_commit": "153f8c7dc8203197ffb3ff14e8856d6c124f001b",
  "fix_summary": "Results render through LazyForEach backed by a LazyData data source (already used elsewhere in the app), so rows are created on demand and recycled.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_cloudmusic_0040",
    "py_file": "testcase/PerfLoad_cloudmusic_0040.py",
    "descriptor": "testcase/PerfLoad_cloudmusic_0040.json",
    "install_dir": "perf_testing/hapray/testcases/cc.chenlvin.cloudmusic",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_cloudmusic_0040.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 30,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "search_list_render_cpu_and_jank",
      "definition": "(a) UI-thread CPU from results display to end of scroll; (b) count of SongCard component builds; (c) dropped frames while scrolling.",
      "comparison": "unfixed builds all accumulated rows (150+ after 5 pages) at once; fixed builds only visible rows. unfixed first-paint after load-more and scroll CPU measurably higher; more jank frames."
    },
    "legacy_instrumented_evidence": {
      "status": "supporting",
      "measured_as": "SongCard builds",
      "unfixed": [
        150,
        150,
        150
      ],
      "fixed": [
        12,
        12,
        12
      ],
      "note": "150 vs 12 row builds per render (mechanism counter, authoritative); whole-step hw-instruction medians are flat (3.4M vs 3.5M) because the window is dominated by page setup, so the declared metric needs a narrower region to separate (measurements-staging)."
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py cloudmusic_search_result_foreach",
    "python3 tools/sign_clean_cases.py cloudmusic_search_result_foreach",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/cloudmusic_search_result_foreach/testcase/ into perf_testing/hapray/testcases/cc.chenlvin.cloudmusic/.",
    "Install each clean signed variant and run the PerfLoad_cloudmusic_0040 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
