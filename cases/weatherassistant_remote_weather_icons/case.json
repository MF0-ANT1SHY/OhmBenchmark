  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "icon_first_paint_ms_and_net_bytes",
      "definition": "(a) Time from page build start to weather-icon render completion in the ace trace; (b) bytes of image downloads to the icon CDN observed in the network trace.",
      "comparison": "unfixed downloads ~9 images (hundreds of KB) before/while icons appear and shows network stalls on cold start; fixed has zero icon-related network traffic and near-instant icon paint."
    },
    "legacy_instrumented_evidence": {
      "status": "expected",
      "measured_as": "icon fetch+decode instructions",
      "unfixed": [],
      "fixed": [],
      "note": "icons come from a remote CDN on every cold start; fixed loads them from local resources, so fetch+decode instructions dominate the diff"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py weatherassistant_remote_weather_icons",
    "python3 tools/sign_clean_cases.py weatherassistant_remote_weather_icons",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/weatherassistant_remote_weather_icons/testcase/ into perf_testing/hapray/testcases/com.alatus.futureweather/.",
    "Install each clean signed variant and run the PerfLoad_weatherassistant_0020 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
