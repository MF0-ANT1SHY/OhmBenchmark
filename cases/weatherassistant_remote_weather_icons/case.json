  "android_mechanism": "Check whether a download is really required before performing it (static assets re-fetched every time)",
  "category": "latency",
  "bug_description": "The weather condition glyphs (sunny/cloudy/overcast/rain) are rendered from four hard-coded remote CDN URLs (i-blog.csdnimg.cn). The forecast view shows ~9 icon instances per city tab (big current-weather icon plus per-day day/night icons); every cold start and every cache miss re-downloads these static images over the network, delaying first paint of the weather panel and wasting bandwidth.",
  "perf_scenarios": [
    "图片加载",
    "页面启动",
    "页面切换"
  ],
  "unfixed_commit": "20e8e16b0c81fd5dee14b636433089cc2796f707",
  "fixed_commit": "c181b312ec1c31ad1ea13641b2953fa2efd4778f",
  "fix_summary": "The four weather glyphs are bundled as local rawfile resources and referenced with $rawfile, eliminating the network fetches and speeding up first render.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_weatherassistant_0020",
    "py_file": "testcase/PerfLoad_weatherassistant_0020.py",
    "descriptor": "testcase/PerfLoad_weatherassistant_0020.json",
    "install_dir": "perf_testing/hapray/testcases/com.alatus.futureweather",
    "driver": "DeviceTest",
    "module": "alatus",
    "ability": "AlatusAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_weatherassistant_0020.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 25,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
