  "test_oracle": {
    "metric": "startup_icons_elapsed_s",
    "definition": "Cold launch until all nine weather icons are pixel-complete, with identical ordinary forecasts and image bytes under declared four-second remote-image latency. Every paired conservative ratio and median must reach 2.0x. Native scheduler CPU is diagnostic only.",
    "comparison": "unfixed conservative lower bound >= 2.0 * fixed upper bound over 3 paired rounds",
    "evidence": {
      "status": "measured_clean",
      "metric": "startup_icons_elapsed_s",
      "unfixed": [
        5.178534800001216,
        5.248315900000307,
        5.398252799997863
      ],
      "fixed": [
        1.6858432000008179,
        1.7835522000023047,
        1.7441524000023492
      ],
      "median_ratio": 2.272420575171862,
      "rounds_per_variant": 3,
      "legacy_evidence_reused": false,
      "note": "Normal cold launch until all nine native icon regions match exact complete pixels. Identical four-day forecasts and image bytes; declared 4-second remote image latency. Each unfixed lower bound must exceed twice its paired fixed upper bound. Native scheduler CPU is diagnostic, not the acceptance metric."
    },
    "mechanism_oracle": {
      "metric": "native_complete_icon_pixels",
      "definition": "Nine native image regions exactly match the complete reference, with correct forecast text. Two city requests per variant; four delayed image requests for unfixed and zero for fixed. No application probes.",
      "comparison": "All three pairs must preserve complete forecast and image content."
    },
    "legacy_instrumented_evidence": {
      "status": "expected",
      "measured_as": "icon fetch+decode instructions",
      "unfixed": [],
      "fixed": [],
      "note": "icons come from a remote CDN on every cold start; fixed loads them from local resources, so fetch+decode instructions dominate the diff"
    }
  },
