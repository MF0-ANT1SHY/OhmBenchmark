{
  "bundle": "com.alatus.futureweather",
  "ability": "AlatusAbility",
  "description": "HarmonyOS-Next-Weather-Assistant页面操作",
  "setup": [
    {
      "op": "wait",
      "selector": {
        "text": "添加"
      }
    },
    {
      "op": "stop"
    },
    {
      "op": "wait",
      "selector": {
        "text": "深圳市",
        "match": "exact"
      },
      "timeout_s": 60
    },
    {
      "op": "wait",
      "selector": {
        "text": "近期天气",
        "match": "exact"
      },
      "timeout_s": 60
    }
  ],
  "measured": [
    {
      "op": "launch"
    },
    {
      "op": "wait",
      "selector": {
        "text": "添加"
      }
    },
    {
      "op": "pause",
      "seconds": 3
    }
  ],
  "verify": [
    {
      "op": "wait",
      "selector": {
        "text": "添加"
      }
    }
  ]
}
