    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "log_calls_per_pageload",
      "definition": "Count of hilog invocations from the app during page load (progress-event logs), and UI-thread CPU from tap to page-end.",
      "comparison": "unfixed logs on every progress event (dozens per page); fixed logs <= 5 per page. unfixed page-load UI CPU > fixed."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions over the web progress-callback window (Pura 70 Ultra)",
      "unfixed": [
        4916252,
        4181742,
        4416890
      ],
      "fixed": [
        3937338,
        3515289,
        3460033
      ],
      "note": "4.42M vs 3.52M median hw-instructions (1.26x, disjoint ranges); mechanism counter 101 vs 5 hilog calls per page load (measurements-staging)."
    }
  },
