{
  "id": "sheafreader_insert_duplicate_exception",
  "host_app": {
    "name": "Sheaf-Reader (束阅 RSS 阅读器)",
    "repository": "https://github.com/simon2137/Sheaf-Reader",
    "bundle_name": "com.sheafreader.hm",
    "local_path": "hosts/sheafreader",
    "base_branch": "ohmbase",
    "base_commit": "e04ef65"
  },
  "android_source_case": "fdroid_skip_unchanged_installed_apps",
  "android_mechanism": "Unchanged items re-processed (rehashed) on every refresh; fix skips unchanged items cheaply",
  "category": "cpu",
  "bug_description": "insertArticle detects duplicates by letting the UNIQUE(feed_id, guid) constraint fail and catching the thrown exception ('Duplicate entry, ignore'). Every feed refresh re-attempts inserts for ALL previously seen articles — each one a full insert attempt that ends in a constraint-violation exception (statement execution + error object construction + catch), multiplying refresh cost with stored article count.",
  "perf_scenarios": [
    "数据库读取",
    "网络结果渲染"
  ],
  "unfixed_commit": "4c9b8dcdc7f230b68120fb5c7640c4cce3521a88",
  "fixed_commit": "ba9a953d20c146d20aa26ba337ba0cee026a3693",
  "fix_summary": "Inserts run with ConflictResolution.ON_CONFLICT_IGNORE so SQLite silently skips duplicates without exception overhead; behavior (only new articles stored) is unchanged.",
  "build": {
    "mode": "release",
    "build_unfixed": "PASS",
    "build_fixed": "PASS"
  },
  "testcase": {
    "name": "PerfLoad_sheafreader_0030",
    "py_file": "testcase/PerfLoad_sheafreader_0030.py",
    "descriptor": "testcase/PerfLoad_sheafreader_0030.json",
    "install_dir": "perf_testing/hapray/testcases/com.sheafreader.hm",
    "driver": "DeviceTest",
    "module": "entry",
    "ability": "EntryAbility",
    "trigger": "external_ui",
    "workload": "testcase/PerfLoad_sheafreader_0030.workload.json"
  },
  "collection": {
    "config": "../collection.yaml",
    "modes": [
      "htrace",
      "hiperf"
    ],
    "step_duration_s": 60,
    "rounds": 3,
    "outputs": [
      "htrace/trace.htrace",
      "hiperf/perf.data",
      "pids.json",
      "memory/",
      "ui/",
      "thermal/"
    ]
  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "trace_cpu_ms",
      "definition": "CPU time across the no-op refresh case window, from trace.",
      "comparison": "unfixed pays statement-execution + exception-throw/catch per stored article; fixed pays a cheap ignored insert. unfixed no-op refresh CPU > fixed by a clear margin scaling with stored article count."
    },
    "legacy_instrumented_evidence": {
      "status": "measured",
      "measured_as": "perf_hw-instructions",
      "unfixed": [
        12837909544,
        11594010171,
        14676652174
      ],
      "fixed": [
        4922802397,
        4907621328,
        4944325933
      ],
      "note": "12.8G vs 4.92G instructions (2.6x) over the no-op refresh phase"
    }
  },
  "reproduction": [
    "python3 tools/reconstruct_clean_hosts.py",
    "python3 tools/build_clean_cases.py sheafreader_insert_duplicate_exception",
    "python3 tools/sign_clean_cases.py sheafreader_insert_duplicate_exception",
    "Prepare the external workload fixtures; never apply measurement patches to the app.",
    "Copy all files from cases/sheafreader_insert_duplicate_exception/testcase/ into perf_testing/hapray/testcases/com.sheafreader.hm/.",
    "Install each clean signed variant and run the PerfLoad_sheafreader_0030 HapRay testcase for >= 3 rounds.",
    "Verify the real UI path and compare the declared CPU/memory metric; build/smoke success alone is not a performance verdict."
  ],
