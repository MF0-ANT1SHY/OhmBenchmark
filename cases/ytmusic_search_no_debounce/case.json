  },
  "test_oracle": {
    "metric": "hiperf_instructions",
    "definition": "raw-instruction-retired sample count attributed to the app process during the measured step, aggregated from perf.data (HapRay perf.db instruction counts).",
    "comparison": "unfixed >= 1.2 * fixed over >= 3 rounds per variant",
    "evidence": {
      "status": "pending_clean_measurement",
      "note": "Legacy instrumented measurements do not validate these business-only builds."
    },
    "mechanism_oracle": {
      "metric": "search_requests_per_query",
      "definition": "Count of outbound HTTP search requests observed in the network trace while typing one 10-character query (plus submit).",
      "comparison": "unfixed: ~11 requests per typed query (one per keystroke + submit); fixed: 1-2 requests. Corresponding CPU/radio activity and result-list re-renders drop proportionally."
    },
    "legacy_instrumented_evidence": {
      "status": "expected",
      "measured_as": "search requests per query",
      "unfixed": [],
      "fixed": [],
      "note": "unfixed issues ~11 requests per typed query vs 1-2 fixed; each extra request costs serialise+send+parse+render instructions"
    }
  },
